# Tests for forward protocol parsing (tcp / udp / both)
import "std/test"
import "../src/common/protocol.alya" as proto

function main()
    test_suite("Forward Protocol Mode Suite")
    let r = runner_new()

    runner_assert_eq(r, proto::parse_forward_protocol("tcp"), 1, "tcp parses to 1")
    runner_assert_eq(r, proto::parse_forward_protocol("TCP"), 1, "TCP parses to 1")
    runner_assert_eq(r, proto::parse_forward_protocol("udp"), 2, "udp parses to 2")
    runner_assert_eq(r, proto::parse_forward_protocol("UDP"), 2, "UDP parses to 2")
    runner_assert_eq(r, proto::parse_forward_protocol("both"), 3, "both parses to 3")
    runner_assert_eq(r, proto::parse_forward_protocol("BOTH"), 3, "BOTH parses to 3")
    runner_assert_eq(r, proto::parse_forward_protocol(""), 3, "empty defaults to both")
    runner_assert_eq(r, proto::parse_forward_protocol("garbage"), 3, "unknown defaults to both")
    runner_assert_eq(r, proto::fwd_tcp_only(), 1, "fwd_tcp_only is 1")
    runner_assert_eq(r, proto::fwd_udp_only(), 2, "fwd_udp_only is 2")
    runner_assert_eq(r, proto::fwd_both(), 3, "fwd_both is 3")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
