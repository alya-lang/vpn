# Alya VPN - Native Foreign Function Interface (FFI) declarations
# Connects Alya runtime to high-speed ChaCha20-Poly1305 and OS process inspection engine

extern "C"
    function alya_vpn_derive_key(passphrase: str, out_key_hex: ptr) -> void
    function alya_vpn_gen_nonce(out_nonce_hex: ptr) -> void
    function alya_vpn_encrypt(key_hex: str, nonce_hex: str, plaintext: str, plain_len: i32, out_cipher_hex: ptr, out_tag_hex: ptr) -> i32
    function alya_vpn_decrypt(key_hex: str, nonce_hex: str, cipher_hex: str, cipher_len: i32, tag_hex: str, out_plain: ptr) -> i32
    function alya_vpn_pack_frame(key_hex: str, msg_type: i32, payload: str, payload_len: i32) -> str
    function alya_vpn_unpack_frame(key_hex: str, frame_line: str, frame_len: i32) -> str
    function alya_vpn_unpack_frame_type() -> i32

    # Binary frame format (new, replaces text-based hex format)
    # Frame: [Magic: 2 bytes 'A','V'] [Version: 1 byte 0x01] [Type: 1 byte] [Nonce: 12 bytes] [Tag: 16 bytes] [Ciphertext: N bytes]
    function alya_vpn_pack_frame_bin(key_hex: str, msg_type: i32, payload: str, payload_len: i32, out_frame_len: ptr) -> ptr
    function alya_vpn_unpack_frame_bin(key_hex: str, frame: ptr, frame_len: i32) -> str
    function alya_vpn_unpack_frame_bin_type() -> i32

    function alya_vpn_get_process_by_port(local_port: i32, out_name: ptr, max_len: i32) -> i32
    function alya_vpn_get_process_by_peer_port(proxy_local_port: i32, peer_remote_port: i32, out_name: ptr, max_len: i32) -> i32
    function alya_vpn_get_udp_process_by_port(local_port: i32, out_name: ptr, max_len: i32) -> i32
    function alya_vpn_socks5_handshake(client_sock: i32, out_host: ptr, max_host_len: i32) -> i32
    function alya_vpn_sock_recv_hex(sock: i32, max_bytes: i32) -> str
    function alya_vpn_sock_send_hex(sock: i32, hex_str: str, hex_len: i32) -> i32
    function alya_vpn_pack_data_payload(channel_id: i32, hex_data: str) -> str

    # Session key management in native C
    function alya_vpn_set_session_passphrase(passphrase: str) -> void
    function alya_vpn_set_session_key(key_hex: str) -> void
    function alya_vpn_get_session_key() -> str

    # Native Routing Engine (immune to string buffer wrap-around)
    function alya_vpn_set_routing(mode: i32, apps_csv: str) -> void
    function alya_vpn_add_routing_app(app_name: str) -> void
    function alya_vpn_sleep_ms(ms: i32) -> void
    function alya_vpn_check_peer_route(proxy_local_port: i32, peer_remote_port: i32, out_proc_name: ptr, max_len: i32) -> i32
    function alya_vpn_should_route(proc_name: str) -> i32
    function alya_vpn_should_route_host(host: str, port: i32) -> i32
    function alya_vpn_infer_process_from_host(host: str, out_name: ptr, max_len: i32) -> i32
    function alya_vpn_set_tunnel_dns(enable: i32) -> void
    function alya_vpn_get_tunnel_dns() -> i32
    function alya_vpn_dns_clear() -> void
    function alya_vpn_add_dns_server(server: str) -> void
    function alya_vpn_add_dns_resolver(resolver: str) -> void
    function alya_vpn_set_bypass_lan(enable: i32) -> void
    function alya_vpn_get_bypass_lan() -> i32
    function alya_vpn_domain_clear() -> void
    function alya_vpn_add_routing_domain(domain: str) -> void
    function alya_vpn_set_timeouts(handshake_ms: i32, connect_ms: i32) -> void
    function alya_vpn_set_tcp_nodelay(enable: i32) -> void
    function alya_vpn_get_tcp_nodelay() -> i32
    function alya_vpn_set_server_log_connections(enable: i32) -> void
    function alya_vpn_get_server_log_connections() -> i32

    # Custom TCP listen (specific bind IP: 127.0.0.1, 0.0.0.0, etc.)
    function alya_vpn_tcp_listen(bind_addr: str, port: i32, backlog: i32) -> i32
    function alya_vpn_tcp_listen6(bind_addr6: str, port: i32, backlog: i32) -> i32
    function alya_vpn_tcp_bound_port(sock: i32) -> i32

    # Forward protocol mode: 1 = TCP only, 2 = UDP only, 3 = both
    function alya_vpn_set_forward_protocol(mode: i32) -> void
    function alya_vpn_get_forward_protocol() -> i32

    # Client UDP relay (SOCKS5 UDP ASSOCIATE endpoint, UDP-over-TCP tunnel)
    function alya_vpn_udp_relay_init(bind_addr: str, port: i32) -> i32
    function alya_vpn_udp_relay_port() -> i32
    function alya_vpn_udp_relay_port6() -> i32
    function alya_vpn_pump_client_udp_out(vpn_sock: i32) -> i64
    function alya_vpn_udp_clear() -> void
    function alya_vpn_udp_resync() -> void

    # Server per-client UDP association tables
    function alya_vpn_srv_udp_clear() -> void
    function alya_vpn_srv_udp_close_all() -> void

    # Server SSRF Protection & Port Restriction
    function alya_vpn_set_server_block_lan(enable: i32) -> void
    function alya_vpn_get_server_block_lan() -> i32
    function alya_vpn_server_clear_blocked_ports() -> void
    function alya_vpn_server_add_blocked_port(port: i32) -> void
    function alya_vpn_server_is_port_blocked(port: i32) -> i32

    # Server Max Clients & Atomic Active Client Tracking
    function alya_vpn_srv_set_max_clients(max_clients: i32) -> void
    function alya_vpn_srv_get_max_clients() -> i32
    function alya_vpn_srv_get_active_clients() -> i32
    function alya_vpn_srv_client_connected() -> i32
    function alya_vpn_srv_client_disconnected() -> void

    # Client Custom LAN Ranges
    function alya_vpn_clear_custom_lan() -> void
    function alya_vpn_add_custom_lan(range_or_domain: str) -> void

    # Channel Idle Timeout & Keep-Alive Ping
    function alya_vpn_set_idle_timeout_sec(sec: i32) -> void
    function alya_vpn_get_idle_timeout_sec() -> i32
    function alya_vpn_set_ping_interval_sec(sec: i32) -> void
    function alya_vpn_get_ping_interval_sec() -> i32
    function alya_vpn_send_ping(sock: i32, ch_id: i32) -> i32

    # Traffic Metrics & Timing
    function alya_vpn_stats_get_summary() -> str
    function alya_vpn_stats_reset() -> void
    function alya_vpn_get_time_ms() -> i32

    # Client Channel Table (O(1), zero Alya allocations)
    function alya_vpn_ch_set(channel_id: i32, app_sock: i32) -> void
    function alya_vpn_ch_get(channel_id: i32) -> i32
    function alya_vpn_ch_remove(channel_id: i32) -> void
    function alya_vpn_ch_count() -> i32
    function alya_vpn_ch_id_at(index: i32) -> i32
    function alya_vpn_ch_sock_at(index: i32) -> i32
    function alya_vpn_ch_clear() -> void

    # Client Direct Bypass Table
    function alya_vpn_direct_set(app_sock: i32, dest_sock: i32) -> void
    function alya_vpn_direct_get(app_sock: i32) -> i32
    function alya_vpn_direct_remove(app_sock: i32) -> void
    function alya_vpn_direct_count() -> i32
    function alya_vpn_direct_app_at(index: i32) -> i32
    function alya_vpn_direct_dest_at(index: i32) -> i32
    function alya_vpn_direct_clear() -> void
    function alya_vpn_open_direct(app_sock: i32, host: str, port: i32) -> i32
    function alya_vpn_pump_direct() -> i32

    # Server Channel Table
    function alya_vpn_srv_ch_set(channel_id: i32, dest_sock: i32) -> void
    function alya_vpn_srv_ch_get(channel_id: i32) -> i32
    function alya_vpn_srv_ch_remove(channel_id: i32) -> void
    function alya_vpn_srv_ch_count() -> i32
    function alya_vpn_srv_ch_id_at(index: i32) -> i32
    function alya_vpn_srv_ch_sock_at(index: i32) -> i32
    function alya_vpn_srv_ch_clear() -> void
    function alya_vpn_srv_close_all() -> void

    # Native High-Speed VPN Tunnel Pumps (Zero Alya Allocations, Raw Binary Streaming)
    function alya_vpn_open_client_channel(vpn_sock: i32, channel_id: i32, host: str, port: i32, app_sock: i32) -> i32
    function alya_vpn_pump_client_vpn(vpn_sock: i32) -> i64
    function alya_vpn_pump_server_vpn(client_sock: i32) -> i64
    function alya_vpn_set_system_proxy(enable: i32, port: i32) -> void
    function alya_vpn_init_system_proxy_hook() -> void
    function alya_vpn_is_stop_requested() -> i32
    function alya_vpn_request_stop() -> void

    # ============================================================================
    # Thread Pool API
    # ============================================================================
    # Initialize thread pool with specified worker counts
    # crypto_workers: number of crypto worker threads (0 = auto, default 4)
    # io_workers: number of I/O worker threads (0 = auto, default 8)
    # Returns 0 on success, -1 on failure
    function alya_vpn_ffi_thread_pool_init(crypto_workers: i32, io_workers: i32) -> i32

    # Shutdown thread pool and wait for all workers to exit
    function alya_vpn_ffi_thread_pool_shutdown() -> void

    # Submit crypto work (encrypt/decrypt)
    # work_json: JSON string with work parameters
    # Returns 0 on success, -1 if queue full, -2 if not initialized
    function alya_vpn_ffi_submit_crypto_work(work_json: str) -> i32

    # Submit I/O work (read/write/accept)
    # work_json: JSON string with work parameters
    # Returns 0 on success, -1 if queue full, -2 if not initialized
    function alya_vpn_ffi_submit_io_work(work_json: str) -> i32

    # Assign channel to specific I/O worker for affinity
    # channel_id: channel identifier
    # worker_id: I/O worker index (0 to io_worker_count-1), or -1 for round-robin
    function alya_vpn_ffi_assign_channel_worker(channel_id: i32, worker_id: i32) -> void

    # Get assigned I/O worker for channel
    function alya_vpn_ffi_get_channel_worker(channel_id: i32) -> i32

    # Check if thread pool is initialized
    function alya_vpn_ffi_thread_pool_is_initialized() -> i32

    # Wait for all pending work to complete (drain queues)
    function alya_vpn_ffi_thread_pool_drain() -> void

    # ============================================================================
    # Buffer Pool API
    # ============================================================================
    # Initialize the global buffer pool (call once at startup)
    function alya_vpn_buffer_pool_init() -> void

    # Shutdown and free all resources
    function alya_vpn_buffer_pool_shutdown() -> void

    # Acquire a buffer from the pool
    # Returns buffer index (0 to ALYA_BUFFER_COUNT-1) or -1 on failure
    function alya_vpn_buffer_acquire() -> i32

    # Release a buffer back to the pool
    # buffer_id: index returned by alya_vpn_buffer_acquire
    function alya_vpn_buffer_release(buffer_id: i32) -> void

    # Get pointer to buffer data (for direct memory access)
    # Returns NULL if buffer_id is invalid
    function alya_vpn_buffer_data(buffer_id: i32) -> ptr

    # Get used bytes in buffer
    function alya_vpn_buffer_used(buffer_id: i32) -> i32

    # Set used bytes in buffer (for manual frame construction)
    function alya_vpn_buffer_set_used(buffer_id: i32, used: i32) -> void

    # Reset buffer (mark as empty, keep ownership)
    function alya_vpn_buffer_reset(buffer_id: i32) -> void

    # Get buffer capacity (always ALYA_BUFFER_SIZE)
    function alya_vpn_buffer_capacity(buffer_id: i32) -> i32

    # Receive directly into pool buffer (eliminates copy)
    # sock: socket descriptor
    # buffer_id: buffer from alya_vpn_buffer_acquire()
    # max_bytes: maximum bytes to receive (up to ALYA_MAX_PAYLOAD)
    # Returns: bytes received (>0), 0 on EOF, -1 on error
    function alya_vpn_sock_recv_into_buffer(sock: i32, buffer_id: i32, max_bytes: i32) -> i32

    # Send from pool buffer (zero-copy)
    # sock: socket descriptor
    # buffer_id: buffer from alya_vpn_buffer_acquire()
    # offset: offset within buffer to start sending from
    # len: number of bytes to send
    # Returns: bytes sent (>0), 0 on EOF, -1 on error
    function alya_vpn_sock_send_from_buffer(sock: i32, buffer_id: i32, offset: i32, len: i32) -> i32

    # Build binary frame directly in pool buffer
    # buffer_id: acquired buffer
    # key_hex: 64-char hex key (or NULL to use session key)
    # msg_type: message type (1 byte)
    # payload: plaintext payload
    # payload_len: payload length
    # out_frame_len: output total frame length (header + ciphertext)
    # Returns: pointer to frame in buffer (or NULL on error)
    function alya_vpn_pack_frame_into_buffer(buffer_id: i32, key_hex: str, msg_type: i32, payload: str, payload_len: i32, out_frame_len: ptr) -> ptr

    # Parse binary frame from pool buffer
    # buffer_id: buffer containing frame
    # frame_len: total frame length
    # Returns: pointer to decrypted plaintext in static thread-local buffer, or NULL on error
    function alya_vpn_unpack_frame_from_buffer(key_hex: str, buffer_id: i32, frame_len: i32) -> str

    # Get message type of last successfully unpacked frame
    function alya_vpn_unpack_frame_buffer_type() -> i32
end
