# Alya VPN - Server Engine and Traffic Forwarder
# Listens for client tunnels, authenticates frames, and forwards payload traffic to destination hosts

import "std/net" as net
import "std/thread" as thread
import "../common/crypto.alya" as crypto
import "../common/protocol.alya" as proto
import "../common/thread_pool.alya" as tpool
import "../ffi.alya"

function vpn_run_server(cfg, client_thread_handler)
    let listen_port = cfg["port"]
    let passphrase = cfg["passphrase"]
    let crypto_threads = cfg["crypto_threads"]
    let io_threads = cfg["io_threads"]
    let backlog = cfg["backlog"]
    let tcp_nodelay = cfg["tcp_nodelay"]
    let log_connections = cfg["log_connections"]
    let log_client_events = cfg["log_client_events"]
    let max_clients = cfg["max_clients"]
    let allowed_clients = cfg["allowed_clients"]
    let bind_address = cfg["bind_address"]
    let block_lan = cfg["block_lan_destinations"]
    let forward_protocol = cfg["forward_protocol"] ?? 3
    let blocked_ports = cfg["blocked_ports"]
    let idle_timeout_sec = cfg["idle_timeout_sec"]
    let show_stats = cfg["show_stats"]
    let stats_interval_sec = cfg["stats_interval_sec"]

    # 1. Initialize thread pool
    let tp_init = tpool::thread_pool_init(crypto_threads, io_threads)
    if tp_init != 0
        say("[ERROR] Failed to initialize thread pool")
        return 1
    end
    say("[INFO] Thread pool initialized: " + crypto_threads + " crypto workers, " + io_threads + " I/O workers")

    # 2. Configure native settings in C
    alya_vpn_set_session_passphrase(passphrase)
    alya_vpn_set_tcp_nodelay(tcp_nodelay)
    alya_vpn_set_server_log_connections(log_connections)
    alya_vpn_set_server_block_lan(block_lan)
    alya_vpn_set_forward_protocol(forward_protocol)
    alya_vpn_srv_set_max_clients(max_clients)
    alya_vpn_set_idle_timeout_sec(idle_timeout_sec)

    alya_vpn_server_clear_blocked_ports()
    let bpi = 0
    while bpi < len(blocked_ports)
        alya_vpn_server_add_blocked_port(blocked_ports[bpi])
        bpi += 1
    end

    let server_sock = alya_vpn_tcp_listen(bind_address, listen_port, backlog)
    if server_sock < 0
        say("[ERROR] Failed to bind VPN server to " + bind_address + ":" + listen_port)
        tpool::thread_pool_shutdown()
        return 1
    end

    # Assign listen socket to I/O worker 0
    tpool::thread_pool_assign_channel_worker(-1, 0)

    let nodelay_str = "OFF"
    if tcp_nodelay == 1
        nodelay_str = "ON (Low latency)"
    end
    let log_str = "OFF (Silent)"
    if log_connections == 1
        log_str = "ON (Forward channel events)"
    end
    let ssrf_str = "ENABLED (Protect local networks & cloud metadata)"
    if block_lan == 0
        ssrf_str = "DISABLED"
    end
    let proto_str = when forward_protocol
        is 1 => "TCP only"
        is 2 => "UDP only (UDP-over-TCP tunnel)"
        else => "TCP+UDP (UDP-over-TCP tunnel)"
    end

    say("[INFO] ========================================")
    say("[INFO] Alya VPN Server running on " + bind_address + ":" + listen_port)
    say("[INFO] Encryption:      ChaCha20-Poly1305 AEAD (256-bit)")
    say("[INFO] Backlog:         " + backlog + " pending connections")
    say("[INFO] Max Clients:     " + max_clients + " concurrent")
    say("[INFO] SSRF Protection: " + ssrf_str)
    say("[INFO] Forward Protocol: " + proto_str)
    if len(blocked_ports) > 0
        say("[INFO] Blocked Ports:   " + len(blocked_ports) + " restricted port(s)")
    end
    if idle_timeout_sec > 0
        say("[INFO] Idle Timeout:    " + idle_timeout_sec + " seconds")
    end
    say("[INFO] Optimization:    TCP_NODELAY=" + nodelay_str)
    say("[INFO] Logging:         Connections=" + log_str)
    if len(allowed_clients) > 0
        say("[INFO] Security:        " + len(allowed_clients) + " allowed client IP(s)")
    end
    say("[INFO] Waiting for incoming client connections...")
    say("[INFO] ========================================")

    let last_stats_ms = alya_vpn_get_time_ms()

    while 1
        # Poll for new client connection (500ms timeout)
        let poll_res = net::tcp_poll(server_sock, 500)
        if poll_res == 1
            # Guarded: a throwing accept must not kill a server carrying
            # live client threads.
            let client_sock = -1
            try
                client_sock = net::tcp_accept(server_sock)
            catch accept_err
                client_sock = -1
            end
            if client_sock >= 0
                let client_ip = net::tcp_peer_ip(client_sock)
                let client_port = net::tcp_peer_port(client_sock)

                # Check IP whitelist if configured
                let allowed = 1
                if len(allowed_clients) > 0
                    allowed = 0
                    let aci = 0
                    while aci < len(allowed_clients)
                        if allowed_clients[aci] == client_ip
                            allowed = 1
                            break
                        end
                        aci += 1
                    end
                end

                if allowed == 0
                    say("[WARN] Connection rejected from unauthorized client: " + client_ip)
                    net::tcp_close(client_sock)
                else
                    # Atomically enforce max clients limit
                    if alya_vpn_srv_client_connected() == 0
                        say("[WARN] Connection rejected: server reached maximum capacity (" + max_clients + " clients)")
                        net::tcp_close(client_sock)
                    else
                        if log_client_events == 1
                            say("[INFO] Client connected from " + client_ip + ":" + client_port + " (" + alya_vpn_srv_get_active_clients() + "/" + max_clients + " active)")
                        end
                        # Spawn via handler supplied by the importing entrypoint.
                        thread::thread_spawn(client_thread_handler, client_sock)
                    end
                end
            end
        end

        # Periodic statistics report
        if show_stats == 1
            let now_ms = alya_vpn_get_time_ms()
            if (now_ms - last_stats_ms) >= (stats_interval_sec * 1000)
                say("[STATS] " + alya_vpn_stats_get_summary())
                last_stats_ms = now_ms
            end
        end
    end

    net::tcp_close(server_sock)
    tpool::thread_pool_shutdown()
    return 0
end

# Thread entry point: passed from main as server::vpn_client_thread.
# Each call runs in its own OS thread with an isolated Alya heap.
function vpn_client_thread(client_sock)
    let client_ip = net::tcp_peer_ip(client_sock)
    let client_port = net::tcp_peer_port(client_sock)
    let client_addr = client_ip
    if client_port > 0
        client_addr = client_ip + ":" + client_port
    end

    vpn_handle_client(client_sock, "")
    alya_vpn_srv_client_disconnected()
    say("[INFO] Client disconnected: " + client_addr + " (" + alya_vpn_srv_get_active_clients() + "/" + alya_vpn_srv_get_max_clients() + " active)")
    return 0
end

# Handles a single connected client session
function vpn_handle_client(client_sock, _session_key)
    alya_vpn_srv_ch_clear()
    alya_vpn_srv_udp_clear()

    while 1
        let activity = 0
        let res = alya_vpn_pump_server_vpn(client_sock)
        if res < 0 or res == 4294967295 or res == -1
            # Client disconnected
            break
        else if res > 0
            activity = 1
        end

        # Sleep 1ms only when idle — prevents busy-wait without adding latency
        if activity == 0
            alya_vpn_sleep_ms(1)
        end
    end

    alya_vpn_srv_close_all()
    alya_vpn_srv_udp_close_all()
    net::tcp_close(client_sock)
end

# Processes decrypted message from client (for backward compatibility)
function vpn_process_client_message(client_sock, session_key, msg_type, payload)
    # CONNECT REQUEST
    if msg_type == proto::msg_connect_req()
        let ok, ch_id, proto_type, host, port = proto::unpack_connect_req_payload(payload)
        if ok == 0
            return 0
        end

        let target_sock = net::tcp_connect(host, port)
        if target_sock < 0
            let resp_payload = proto::pack_connect_resp_payload(ch_id, proto::status_connect_failed(), "Connection refused")
            let resp_frame = proto::pack_frame(session_key, proto::msg_connect_resp(), resp_payload)
            if resp_frame != null
                net::tcp_send(client_sock, resp_frame)
            end
            return 0
        end

        alya_vpn_srv_ch_set(ch_id, target_sock)

        let ok_payload = proto::pack_connect_resp_payload(ch_id, proto::status_ok(), "Connected")
        let ok_frame = proto::pack_frame(session_key, proto::msg_connect_resp(), ok_payload)
        if ok_frame != null
            net::tcp_send(client_sock, ok_frame)
        end
        return 1
    end

    # DATA FORWARD
    if msg_type == proto::msg_data()
        let ok, ch_id, raw_hex = proto::unpack_data_payload(payload)
        if ok == 0
            return 0
        end

        let target_sock = alya_vpn_srv_ch_get(ch_id)
        if target_sock >= 0
            alya_vpn_sock_send_hex(target_sock, raw_hex, len(raw_hex))
        end
        return 1
    end

    # CHANNEL CLOSE
    if msg_type == proto::msg_close()
        let ok, ch_id, reason = proto::unpack_close_payload(payload)
        if ok == 1
            let s = alya_vpn_srv_ch_get(ch_id)
            if s >= 0
                net::tcp_close(s)
                alya_vpn_srv_ch_remove(ch_id)
            end
        end
        return 1
    end

    # PING / KEEP-ALIVE
    if msg_type == proto::msg_ping()
        let pong_frame = proto::pack_frame(session_key, proto::msg_pong(), "PONG")
        if pong_frame != null
            net::tcp_send(client_sock, pong_frame)
        end
        return 1
    end

    return 0
end
