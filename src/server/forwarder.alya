# Alya VPN - Server Engine and Traffic Forwarder
# Listens for client tunnels, authenticates frames, and forwards payload traffic to destination hosts

import "std/net" as net
import "std/os" as os
import "std/thread" as thread
import "../common/crypto.alya" as crypto
import "../common/protocol.alya" as proto
import "../common/thread_pool.alya" as tpool
import "../ffi.alya"

function vpn_run_server(listen_port, passphrase, client_thread_handler, crypto_threads, io_threads)
    # 1. Initialize thread pool
    let tp_init = tpool::thread_pool_init(crypto_threads, io_threads)
    if tp_init != 0
        say("[ERROR] Failed to initialize thread pool")
        return 1
    end
    say("[INFO] Thread pool initialized: " + crypto_threads + " crypto workers, " + io_threads + " I/O workers")

    alya_vpn_set_session_passphrase(passphrase)
    let key = crypto::vpn_derive_key(passphrase)
    let server_sock = net::tcp_listen(listen_port, 32)
    if server_sock < 0
        say("[ERROR] Failed to bind VPN server to port " + listen_port)
        tpool::thread_pool_shutdown()
        return 1
    end

    # Assign listen socket to I/O worker 0
    tpool::thread_pool_assign_channel_worker(-1, 0)

    say("[INFO] ========================================")
    say("[INFO] Alya VPN Server running on port " + listen_port)
    say("[INFO] Encryption: ChaCha20-Poly1305 AEAD (256-bit)")
    say("[INFO] Waiting for incoming client connections...")
    say("[INFO] ========================================")

    while 1
        # Poll for new client connection (500ms timeout) - could submit to I/O worker
        let poll_res = net::tcp_poll(server_sock, 500)
        if poll_res == 1
            let client_sock = net::tcp_accept(server_sock)
            if client_sock >= 0
                let client_ip = net::tcp_peer_ip(client_sock)
                let client_port = net::tcp_peer_port(client_sock)
                say("[INFO] Client connected from " + client_ip + ":" + client_port)
                # Spawn via handler supplied by the importing entrypoint.
                # Alya 0.0.14 miscompiles bare function references inside imported modules.
                thread::thread_spawn(client_thread_handler, client_sock)
            end
        end
    end

    net::tcp_close(server_sock)
    tpool::thread_pool_shutdown()
    return 0
end

# Thread entry point: passed from main as server::vpn_client_thread.
# Each call runs in its own OS thread with an isolated Alya heap.
# session_key is passed as "" — C always uses the cached key from
# alya_vpn_set_session_passphrase (immune to Alya bump allocator corruption).
function vpn_client_thread(client_sock)
    let client_ip = net::tcp_peer_ip(client_sock)
    vpn_handle_client(client_sock, "")
    say("[INFO] Client disconnected: " + client_ip)
    return 0
end

# Handles a single connected client session
function vpn_handle_client(client_sock, session_key)
    alya_vpn_srv_ch_clear()

    while 1
        let activity = 0
        let res = alya_vpn_pump_server_vpn(client_sock)
        if res > 0
            activity = 1
        else if res < 0
            # Client disconnected
            break
        end

        # Sleep 1ms only when idle — prevents busy-wait without adding latency
        if activity == 0
            alya_vpn_sleep_ms(1)
        end
    end

    alya_vpn_srv_close_all()
    net::tcp_close(client_sock)
end

# Processes decrypted message from client
function vpn_process_client_message(client_sock, session_key, msg_type, payload)
    # CONNECT REQUEST
    if msg_type == proto::msg_connect_req()
        let ok, ch_id, proto_type, host, port = proto::unpack_connect_req_payload(payload)
        if ok == 0
            return 0
        end

        say("[FORWARD] CONNECT requested: Channel " + ch_id + " -> " + host + ":" + port)

        let target_sock = net::tcp_connect(host, port)
        if target_sock < 0
            say("[FORWARD] Failed to connect to " + host + ":" + port)
            let resp_payload = proto::pack_connect_resp_payload(ch_id, proto::status_connect_failed(), "Connection refused")
            let resp_frame = proto::pack_frame(session_key, proto::msg_connect_resp(), resp_payload)
            if resp_frame != null
                net::tcp_send(client_sock, resp_frame)
            end
            return 0
        end

        alya_vpn_srv_ch_set(ch_id, target_sock)
        say("[FORWARD] Connected to " + host + ":" + port + " (Channel " + ch_id + ")")

        let ok_payload = proto::pack_connect_resp_payload(ch_id, proto::status_ok(), "Connected")
        let ok_frame = proto::pack_frame(session_key, proto::msg_connect_resp(), ok_payload)
        if ok_frame != null
            net::tcp_send(client_sock, ok_frame)
        end
        return 1
    end

    # DATA FORWARD
    if msg_type == proto::msg_data()
        let ok, ch_id, raw_hex = proto::unpack_data_payload(payload)
        if ok == 0
            return 0
        end

        let target_sock = alya_vpn_srv_ch_get(ch_id)
        if target_sock >= 0
            alya_vpn_sock_send_hex(target_sock, raw_hex, len(raw_hex))
        end
        return 1
    end

    # CHANNEL CLOSE
    if msg_type == proto::msg_close()
        let ok, ch_id, reason = proto::unpack_close_payload(payload)
        if ok == 1
            let s = alya_vpn_srv_ch_get(ch_id)
            if s >= 0
                net::tcp_close(s)
                alya_vpn_srv_ch_remove(ch_id)
                say("[FORWARD] Closed channel " + ch_id)
            end
        end
        return 1
    end

    # PING / KEEP-ALIVE
    if msg_type == proto::msg_ping()
        let pong_frame = proto::pack_frame(session_key, proto::msg_pong(), "PONG")
        if pong_frame != null
            net::tcp_send(client_sock, pong_frame)
        end
        return 1
    end

    return 0
end
