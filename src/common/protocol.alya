# Alya VPN - Protocol Specification and Frame Serialization
# Pure Alya implementation without external dependencies

import "./crypto.alya" as crypto
import "../ffi.alya"

# Message Types
function msg_handshake_req() return 1 end
function msg_handshake_resp() return 2 end
function msg_connect_req() return 3 end
function msg_connect_resp() return 4 end
function msg_data() return 5 end
function msg_close() return 6 end
function msg_ping() return 7 end
function msg_pong() return 8 end

# Transport Protocols
function proto_tcp() return 1 end
function proto_udp() return 2 end

# Status Codes
function status_ok() return 0 end
function status_auth_failed() return 1 end
function status_connect_failed() return 2 end
function status_error() return 3 end

# Splits string by single character delimiter
function split_string(s, delim)
    let res = []
    let slen = len(s)
    let current = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == delim
            res.push(current)
            current = ""
        else
            current += ch
        end
        i += 1
    end
    res.push(current)
    return res
end

# Finds index of substring
function find_char(s, target_ch)
    let slen = len(s)
    let i = 0
    while i < slen
        if char_at(s, i) == target_ch
            return i
        end
        i += 1
    end
    return -1
end

# Parses string to integer (supports basic positive decimal)
function parse_number(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let res = 0
    let i = 0
    while i < slen
        let c = ord(char_at(s, i))
        if c >= 48 and c <= 57
            res = (res * 10) + (c - 48)
        end
        i += 1
    end
    return res
end

# Converts 1 hex character to 0..15
function hex_char_val(ch)
    let c = ord(ch)
    if c >= 48 and c <= 57
        return c - 48
    end
    if c >= 97 and c <= 102
        return c - 87
    end
    if c >= 65 and c <= 70
        return c - 55
    end
    return 0
end

# Converts 2 hex characters to byte (0..255)
function hex_to_byte(h)
    if len(h) < 2
        return 0
    end
    return (hex_char_val(char_at(h, 0)) * 16) + hex_char_val(char_at(h, 1))
end

# Converts byte (0..255) to 2-digit hex string
function byte_to_hex(b)
    let hex_chars = "0123456789abcdef"
    let hi = (b / 16) % 16
    let lo = b % 16
    return substring(hex_chars, hi, 1) + substring(hex_chars, lo, 1)
end

# Serializes CONNECT_REQ payload: "channel_id|proto|host|port"
function pack_connect_req_payload(channel_id, proto, target_host, target_port)
    return "" + channel_id + "|" + proto + "|" + target_host + "|" + target_port
end

# Parses CONNECT_REQ payload: returns ok, channel_id, proto, target_host, target_port
function unpack_connect_req_payload(payload)
    let parts = split_string(payload, "|")
    if len(parts) < 4
        return 0, 0, 0, "", 0
    end
    return 1, parse_number(parts[0]), parse_number(parts[1]), parts[2], parse_number(parts[3])
end

# Serializes CONNECT_RESP payload: "channel_id|status|message"
function pack_connect_resp_payload(channel_id, status, message)
    return "" + channel_id + "|" + status + "|" + message
end

# Parses CONNECT_RESP payload: returns ok, channel_id, status, message
function unpack_connect_resp_payload(payload)
    let parts = split_string(payload, "|")
    if len(parts) < 2
        return 0, 0, 0, ""
    end
    let msg = if len(parts) >= 3 then parts[2] else ""
    return 1, parse_number(parts[0]), parse_number(parts[1]), msg
end

# Serializes DATA payload: "channel_id|data"
function pack_data_payload(channel_id, raw_data)
    return alya_vpn_pack_data_payload(channel_id, raw_data)
end

# Parses DATA payload: returns ok, channel_id, data_str
function unpack_data_payload(payload)
    let idx = find_char(payload, "|")
    if idx < 0
        return 0, 0, ""
    end
    let ch_str = payload.substring(0, idx)
    let data_str = payload.substring(idx + 1)
    return 1, parse_number(ch_str), data_str
end

# Serializes CLOSE payload: "channel_id|reason"
function pack_close_payload(channel_id, reason)
    return "" + channel_id + "|" + reason
end

# Parses CLOSE payload: returns ok, channel_id, reason
function unpack_close_payload(payload)
    let parts = split_string(payload, "|")
    if len(parts) < 1
        return 0, 0, 0
    end
    let reason = if len(parts) >= 2 then parse_number(parts[1]) else 0
    return 1, parse_number(parts[0]), reason
end

# Packs an authenticated and encrypted envelope frame (BINARY FORMAT)
# Frame structure: [Magic: 2 bytes 'A','V'] [Version: 1 byte 0x01] [Type: 1 byte] [Nonce: 12 bytes] [Tag: 16 bytes] [Ciphertext: N bytes]
# Total header: 32 bytes, Payload: N bytes = 1x overhead vs 2x for legacy hex format
function pack_frame(session_key, msg_type, plaintext_payload)
    let p_len = len(plaintext_payload)
    let out_frame_len = crypto::alloc_str(4)  # 4 bytes for int pointer
    # Note: FFI returns ptr to static buffer, we need to copy it
    let frame_ptr = alya_vpn_pack_frame_bin(session_key, msg_type, plaintext_payload, p_len, out_frame_len)
    if frame_ptr == null
        return null
    end
    # Read the frame length from the output parameter
    # The ptr points to an int, we need to dereference it
    let frame_len = 0
    # Since we can't easily dereference in Alya, we rely on the fact that the binary
    # format has a known header (32 bytes) + payload_len
    frame_len = 32 + p_len

    # Copy binary frame to a string (treating bytes as chars for transport)
    let frame = ""
    let i = 0
    while i < frame_len
        let b = char_at(frame_ptr, i)
        frame = frame + b
        i += 1
    end
    return frame
end

# Unpacks and authenticates an incoming binary frame
# Returns tuple: msg_type, plaintext (or 0, null on failure)
function unpack_frame(session_key, frame_data)
    let frame_len = len(frame_data)
    if frame_len < 32
        return 0, null
    end

    # Convert string to byte pointer for FFI
    let plain = alya_vpn_unpack_frame_bin(session_key, frame_data, frame_len)
    if plain == null
        return 0, null
    end
    let msg_type = alya_vpn_unpack_frame_bin_type()
    if msg_type == 0
        return 0, null
    end
    return msg_type, plain
end
