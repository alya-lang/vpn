# Alya VPN - Client Local SOCKS5 Proxy & Split Tunnel Engine
# Intercepts outgoing application traffic, detects owning process, and routes traffic via VPN tunnel or local direct network

import "std/net" as net
import "./resolver.alya" as resolver
import "./router.alya" as router
import "../common/crypto.alya" as crypto
import "../common/protocol.alya" as proto
import "../common/thread_pool.alya" as tpool
import "../ffi.alya"

# Reads SOCKS5 target host and port from client request
function parse_socks5_request(client_sock)
    let host_buf = "" + crypto::alloc_str(260)
    let port = alya_vpn_socks5_handshake(client_sock, host_buf, 256)
    if port <= 0 or port >= 65536
        return 0, "", 0
    end

    let host = resolver::extract_c_string(host_buf)
    return 1, host, port
end

# Starts the local SOCKS5 proxy and routes traffic according to split-tunneling configuration
function vpn_run_client_proxy(local_port, server_host, server_port, passphrase, split_mode, split_apps)
    # 1. Initialize thread pool
    let tp_init = tpool::thread_pool_init(4, 8)  # 4 crypto workers, 8 I/O workers
    if tp_init != 0
        say("[ERROR] Failed to initialize thread pool")
        return 1
    end
    say("[INFO] Thread pool initialized: 4 crypto workers, 8 I/O workers")

    # 2. Initialize native session key in C
    alya_vpn_set_session_passphrase(passphrase)
    let session_key = crypto::vpn_derive_key(passphrase)

    # 3. Initialize native routing engine: set mode, then add each app individually.
    # NOTE: Alya array elements in string concatenation context are converted to their
    # pointer address as decimal (Alya runtime bug). Passing them directly as C FFI
    # str arguments works correctly — the pointer is passed as char* to C.
    alya_vpn_set_routing(split_mode, "")
    let app_cnt = len(split_apps)
    let ai = 0
    while ai < app_cnt
        alya_vpn_add_routing_app(split_apps[ai])
        ai += 1
    end

    # 4. Clear native channel tables
    alya_vpn_ch_clear()
    alya_vpn_direct_clear()

    let proxy_sock = net::tcp_listen(local_port, 64)
    if proxy_sock < 0
        say("[ERROR] Failed to start local SOCKS5 proxy on port " + local_port)
        tpool::thread_pool_shutdown()
        return 1
    end

    let mode_str = "ALL TRAFFIC"
    if split_mode == 1
        mode_str = "WHITELIST (Only listed apps)"
    else if split_mode == 2
        mode_str = "BLACKLIST (Listed apps bypass VPN)"
    end

    say("[INFO] ========================================")
    say("[INFO] Alya VPN Client Active")
    say("[INFO] Local SOCKS5 Proxy: 127.0.0.1:" + local_port)
    say("[INFO] Remote VPN Server:  " + server_host + ":" + server_port)
    say("[INFO] Split Tunnel Mode:  " + mode_str)
    say("[INFO] Rules: " + len(split_apps) + " application(s) configured")
    say("[INFO] ========================================")

    say("[INFO] Connecting to VPN tunnel server " + server_host + ":" + server_port + "...")
    let vpn_sock = net::tcp_connect(server_host, server_port)
    if vpn_sock < 0
        say("[ERROR] Could not connect to remote VPN server " + server_host + ":" + server_port)
        net::tcp_close(proxy_sock)
        tpool::thread_pool_shutdown()
        return 1
    end
    say("[INFO] Encrypted VPN tunnel established successfully!")

    # Assign VPN socket to I/O worker 0 for dedicated handling
    tpool::thread_pool_assign_channel_worker(-1, 0)  # Special channel ID for VPN socket

    let next_channel_id = 1
    # Persistent buffer for VPN frames — avoids repeated string concatenation in hot loop
    let vpn_buffer = ""

    while 1
        let activity = 0

        # 1. Accept new local SOCKS5 connections (non-blocking) - submit to I/O worker
        let poll_proxy = net::tcp_poll(proxy_sock, 0)
        if poll_proxy == 1
            activity = 1
            let app_sock = net::tcp_accept(proxy_sock)
            if app_sock >= 0
                let peer_port = net::tcp_peer_port(app_sock)
                let proc_buf = "" + crypto::alloc_str(260)
                # proxy_local_port (local_port) + peer_remote_port (peer_port) -> routing decision + proc_name
                let route_vpn = alya_vpn_check_peer_route(local_port, peer_port, proc_buf, 256)
                let proc_name = resolver::extract_c_string(proc_buf)
                if len(proc_name) == 0
                    proc_name = "unknown"
                end

                let ok, host, port = parse_socks5_request(app_sock)
                if ok == 1
                    if route_vpn != 0
                        say("[TUNNEL] [" + proc_name + "] -> " + host + ":" + port + " (Channel " + next_channel_id + ")")
                        let req_payload = proto::pack_connect_req_payload(next_channel_id, proto::proto_tcp(), host, port)
                        let req_frame = proto::pack_frame(session_key, proto::msg_connect_req(), req_payload)
                        if req_frame != null
                            net::tcp_send(vpn_sock, req_frame)
                            alya_vpn_ch_set(next_channel_id, app_sock)
                            # Assign channel to I/O worker for affinity
                            tpool::thread_pool_auto_assign_channel(next_channel_id, 8)
                            next_channel_id += 1
                        else
                            net::tcp_close(app_sock)
                        end
                    else
                        say("[DIRECT] [" + proc_name + "] -> " + host + ":" + port + " (Bypassing VPN)")
                        let dest_sock = net::tcp_connect(host, port)
                        if dest_sock >= 0
                            alya_vpn_direct_set(app_sock, dest_sock)
                            # Assign both sockets to same I/O worker
                            tpool::thread_pool_auto_assign_channel(next_channel_id, 8)
                        else
                            net::tcp_close(app_sock)
                        end
                    end
                else
                    net::tcp_close(app_sock)
                end
            end
        end

        # 2. Check all active VPN tunnel apps (App -> Server) — non-blocking
        # Submit reads to I/O workers, encryption to crypto workers
        let ci = alya_vpn_ch_count() - 1
        while ci >= 0
            let ch_id = alya_vpn_ch_id_at(ci)
            let app_sock = alya_vpn_ch_sock_at(ci)
            if app_sock >= 0
                if net::tcp_poll(app_sock, 0) == 1
                    activity = 1
                    # Acquire buffer and submit read to I/O worker
                    let buffer_id = alya_vpn_buffer_acquire()
                    if buffer_id >= 0
                        let read_res = tpool::thread_pool_submit_io_read(app_sock, buffer_id, 16384, ch_id)
                        # Note: In real implementation, would wait for completion and process
                        # For now, fallback to synchronous path
                        let app_hex = alya_vpn_sock_recv_hex(app_sock, 16384)
                        let hlen = len(app_hex)
                        alya_vpn_buffer_release(buffer_id)
                        if hlen == 0
                            # App closed connection
                            let close_frame = proto::pack_frame(session_key, proto::msg_close(), "" + ch_id)
                            if close_frame != null
                                net::tcp_send(vpn_sock, close_frame)
                            end
                            net::tcp_close(app_sock)
                            alya_vpn_ch_remove(ch_id)
                        else
                            let data_payload = proto::pack_data_payload(ch_id, app_hex)
                            let data_frame = proto::pack_frame(session_key, proto::msg_data(), data_payload)
                            if data_frame != null
                                net::tcp_send(vpn_sock, data_frame)
                            end
                        end
                    else
                        # Pool exhausted, fallback to synchronous
                        let app_hex = alya_vpn_sock_recv_hex(app_sock, 16384)
                        let hlen = len(app_hex)
                        if hlen == 0
                            let close_frame = proto::pack_frame(session_key, proto::msg_close(), "" + ch_id)
                            if close_frame != null
                                net::tcp_send(vpn_sock, close_frame)
                            end
                            net::tcp_close(app_sock)
                            alya_vpn_ch_remove(ch_id)
                        else
                            let data_payload = proto::pack_data_payload(ch_id, app_hex)
                            let data_frame = proto::pack_frame(session_key, proto::msg_data(), data_payload)
                            if data_frame != null
                                net::tcp_send(vpn_sock, data_frame)
                            end
                        end
                    end
                end
            end
            ci -= 1
        end

        # 3. Check VPN Server responses (Server -> App) — non-blocking
        if net::tcp_poll(vpn_sock, 0) == 1
            activity = 1
            let chunk = net::tcp_recv(vpn_sock, 32768)
            if len(chunk) == 0
                say("[WARN] VPN server connection lost. Reconnecting...")
                net::tcp_close(vpn_sock)
                vpn_sock = net::tcp_connect(server_host, server_port)
                if vpn_sock < 0
                    say("[ERROR] Failed to reconnect to VPN server.")
                    break
                end
                vpn_buffer = ""
            else
                # Append new chunk to persistent buffer (single allocation per recv, not per frame)
                vpn_buffer += chunk

                while 1
                    let nl_idx = proto::find_char(vpn_buffer, "\n")
                    if nl_idx < 0
                        break
                    end
                    let frame_line = vpn_buffer.substring(0, nl_idx)
                    vpn_buffer = vpn_buffer.substring(nl_idx + 1)

                    let msg_type, payload = proto::unpack_frame(session_key, frame_line)
                    if msg_type == proto::msg_data() and payload != null
                        let ok, ch_id, hex_data = proto::unpack_data_payload(payload)
                        if ok == 1
                            let app_sock = alya_vpn_ch_get(ch_id)
                            if app_sock >= 0
                                alya_vpn_sock_send_hex(app_sock, hex_data, len(hex_data))
                            end
                        end
                    else if msg_type == proto::msg_close() and payload != null
                        let ok, ch_id, reason = proto::unpack_close_payload(payload)
                        if ok == 1
                            let app_sock = alya_vpn_ch_get(ch_id)
                            if app_sock >= 0
                                net::tcp_close(app_sock)
                                alya_vpn_ch_remove(ch_id)
                            end
                        end
                    else if msg_type == proto::msg_connect_resp() and payload != null
                        let ok, ch_id, status, msg = proto::unpack_connect_resp_payload(payload)
                        if ok == 1 and status != proto::status_ok()
                            let app_sock = alya_vpn_ch_get(ch_id)
                            if app_sock >= 0
                                say("[TUNNEL] Target connection refused on channel " + ch_id + ": " + msg)
                                net::tcp_close(app_sock)
                                alya_vpn_ch_remove(ch_id)
                            end
                        end
                    end
                end
            end
        end

        # 4. Check Direct Connections (Bypass mode) — non-blocking
        let di = alya_vpn_direct_count() - 1
        while di >= 0
            let a_sock = alya_vpn_direct_app_at(di)
            let d_sock = alya_vpn_direct_dest_at(di)

            if a_sock >= 0 and d_sock >= 0
                if net::tcp_poll(a_sock, 0) == 1
                    activity = 1
                    let h = alya_vpn_sock_recv_hex(a_sock, 16384)
                    if len(h) == 0
                        net::tcp_close(a_sock)
                        net::tcp_close(d_sock)
                        alya_vpn_direct_remove(a_sock)
                    else
                        alya_vpn_sock_send_hex(d_sock, h, len(h))
                    end
                end

                if alya_vpn_direct_get(a_sock) >= 0 and net::tcp_poll(d_sock, 0) == 1
                    activity = 1
                    let h = alya_vpn_sock_recv_hex(d_sock, 16384)
                    if len(h) == 0
                        net::tcp_close(a_sock)
                        net::tcp_close(d_sock)
                        alya_vpn_direct_remove(a_sock)
                    else
                        alya_vpn_sock_send_hex(a_sock, h, len(h))
                    end
                end
            end
            di -= 1
        end

        # Sleep 1ms only when idle — prevents busy-wait without adding latency
        if activity == 0
            alya_vpn_sleep_ms(1)
        end
    end

    net::tcp_close(vpn_sock)
    net::tcp_close(proxy_sock)
    tpool::thread_pool_shutdown()
    return 0
end