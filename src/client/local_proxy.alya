# Alya VPN - Client Local SOCKS5 Proxy & Split Tunnel Engine
# Intercepts outgoing application traffic, detects owning process, and routes traffic via VPN tunnel or local direct network

import "std/net" as net
import "./resolver.alya" as resolver
import "./router.alya" as router
import "../common/crypto.alya" as crypto
import "../common/protocol.alya" as proto
import "../common/thread_pool.alya" as tpool
import "../ffi.alya"

# Reads SOCKS5 target host and port from client request
function parse_socks5_request(client_sock)
    let host_buf = "" + crypto::alloc_str(260)
    let port = alya_vpn_socks5_handshake(client_sock, host_buf, 256)
    if port <= 0 or port >= 65536
        return 0, "", 0
    end

    let host = resolver::extract_c_string(host_buf)
    return 1, host, port
end

# Starts the local SOCKS5 proxy and routes traffic according to split-tunneling configuration
function vpn_run_client_proxy(cfg)
    let local_port = cfg["local_port"]
    let server_host = cfg["server_host"]
    let server_port = cfg["server_port"]
    let passphrase = cfg["passphrase"]
    let split_mode = cfg["split_mode"]
    let split_apps = cfg["apps"]
    let split_domains = cfg["domains"]
    let auto_sys_proxy = cfg["auto_sys_proxy"]
    let tunnel_dns = cfg["tunnel_dns"]
    let dns_servers = cfg["dns_servers"]
    let dns_resolvers = cfg["dns_resolvers"]
    let bypass_lan = cfg["bypass_lan"]
    let bypass_lan_ranges = cfg["bypass_lan_ranges"]
    let auto_reconnect = cfg["auto_reconnect"]
    let reconnect_attempts = cfg["reconnect_attempts"]
    let reconnect_interval_ms = cfg["reconnect_interval_ms"]
    let handshake_timeout_ms = cfg["handshake_timeout_ms"]
    let connect_timeout_ms = cfg["connect_timeout_ms"]
    let idle_timeout_sec = cfg["idle_timeout_sec"]
    let ping_interval_sec = cfg["ping_interval_sec"]
    let kill_switch = cfg["kill_switch"]
    let tcp_nodelay = cfg["tcp_nodelay"]
    let log_tunnel_traffic = cfg["log_tunnel_traffic"]
    let log_direct_traffic = cfg["log_direct_traffic"]
    let bind_address = cfg["bind_address"]
    let show_stats = cfg["show_stats"]
    let stats_interval_sec = cfg["stats_interval_sec"]

    # 1. Initialize native session key in C
    alya_vpn_set_session_passphrase(passphrase)
    let session_key = crypto::vpn_derive_key(passphrase)

    # 2. Configure DNS tunneling, servers, and resolvers
    alya_vpn_set_tunnel_dns(tunnel_dns)
    alya_vpn_dns_clear()
    let dsi = 0
    while dsi < len(dns_servers)
        alya_vpn_add_dns_server(dns_servers[dsi])
        dsi += 1
    end
    let dri = 0
    while dri < len(dns_resolvers)
        alya_vpn_add_dns_resolver(dns_resolvers[dri])
        dri += 1
    end

    # 3. Configure LAN bypass and custom subnets
    alya_vpn_set_bypass_lan(bypass_lan)
    alya_vpn_clear_custom_lan()
    let clri = 0
    while clri < len(bypass_lan_ranges)
        alya_vpn_add_custom_lan(bypass_lan_ranges[clri])
        clri += 1
    end

    # 4. Configure timeouts, ping interval, and low-latency TCP_NODELAY
    alya_vpn_set_timeouts(handshake_timeout_ms, connect_timeout_ms)
    alya_vpn_set_tcp_nodelay(tcp_nodelay)
    alya_vpn_set_idle_timeout_sec(idle_timeout_sec)
    alya_vpn_set_ping_interval_sec(ping_interval_sec)

    # 5. Configure domain routing rules (*.example.com, etc.)
    alya_vpn_domain_clear()
    let dmi = 0
    while dmi < len(split_domains)
        alya_vpn_add_routing_domain(split_domains[dmi])
        dmi += 1
    end

    # 6. Initialize native routing engine: set mode, then add each app individually
    alya_vpn_set_routing(split_mode, "")
    let app_cnt = len(split_apps)
    let ai = 0
    while ai < app_cnt
        alya_vpn_add_routing_app(split_apps[ai])
        ai += 1
    end

    let mode_desc = "ALL (route all traffic via VPN)"
    if split_mode == 1
        mode_desc = "INCLUDE / Whitelist (" + app_cnt + " apps, " + len(split_domains) + " domains configured)"
    else if split_mode == 2
        mode_desc = "EXCLUDE / Blacklist (" + app_cnt + " apps, " + len(split_domains) + " domains configured)"
    end
    say("[INFO] Split-Tunneling: " + mode_desc)

    # 7. Clear native channel tables
    alya_vpn_ch_clear()
    alya_vpn_direct_clear()

    let proxy_sock = alya_vpn_tcp_listen(bind_address, local_port, 64)
    if proxy_sock < 0
        say("[ERROR] Failed to start local SOCKS5 proxy on " + bind_address + ":" + local_port)
        tpool::thread_pool_shutdown()
        return 1
    end

    let mode_str = "ALL TRAFFIC"
    if split_mode == 1
        mode_str = "WHITELIST (Only listed apps/domains)"
    else if split_mode == 2
        mode_str = "BLACKLIST (Listed apps/domains bypass VPN)"
    end

    let dns_str = "BYPASS (Local DNS)"
    if tunnel_dns == 1
        let srv_count = len(dns_servers)
        if srv_count > 0
            dns_str = "TUNNELED (" + srv_count + " custom DNS servers)"
        else
            dns_str = "TUNNELED (Built-in default DNS servers)"
        end
    end

    let lan_str = "TUNNELED"
    if bypass_lan == 1
        if len(bypass_lan_ranges) > 0
            lan_str = "BYPASS (LAN + " + len(bypass_lan_ranges) + " custom subnets)"
        else
            lan_str = "BYPASS (192.168.x, 10.x, 172.16-31.x, .local)"
        end
    end

    let nodelay_str = "OFF"
    if tcp_nodelay == 1
        nodelay_str = "ON (Low latency)"
    end

    let ks_str = "OFF"
    if kill_switch == 1
        ks_str = "ON (Block traffic on disconnect)"
    end

    say("[INFO] ========================================")
    say("[INFO] Alya VPN Client Active")
    say("[INFO] Local SOCKS5 Proxy: " + bind_address + ":" + local_port)
    say("[INFO] Remote VPN Server:  " + server_host + ":" + server_port)
    say("[INFO] Split Tunnel Mode:  " + mode_str)
    say("[INFO] DNS Protection:     " + dns_str)
    say("[INFO] LAN Traffic:        " + lan_str)
    say("[INFO] Kill Switch:        " + ks_str)
    say("[INFO] Rules: " + app_cnt + " application(s), " + len(split_domains) + " domain(s) configured")
    say("[INFO] Optimization:       TCP_NODELAY=" + nodelay_str + ", Handshake=" + handshake_timeout_ms + "ms")
    if idle_timeout_sec > 0
        say("[INFO] Idle Timeout:       " + idle_timeout_sec + "s, Ping=" + ping_interval_sec + "s")
    end
    say("[INFO] ========================================")

    say("[INFO] Connecting to VPN tunnel server " + server_host + ":" + server_port + "...")
    let vpn_sock = net::tcp_connect(server_host, server_port)
    if vpn_sock < 0
        say("[ERROR] Could not connect to remote VPN server " + server_host + ":" + server_port)
        net::tcp_close(proxy_sock)
        tpool::thread_pool_shutdown()
        return 1
    end
    say("[INFO] Encrypted VPN tunnel established successfully!")

    alya_vpn_init_system_proxy_hook()

    if auto_sys_proxy == 1
        alya_vpn_set_system_proxy(1, local_port)
        say("[INFO] System Proxy automatically configured (127.0.0.1:" + local_port + ")")
    end

    tpool::thread_pool_assign_channel_worker(-1, 0)

    let next_channel_id = 1
    let last_stats_ms = alya_vpn_get_time_ms()

    while 1
        if alya_vpn_is_stop_requested() == 1
            say("\n[INFO] Shutdown signal received. Restoring system proxy and DNS...")
            break
        end

        let activity = 0

        # 1. Accept new local SOCKS5 connections (non-blocking)
        let poll_proxy = net::tcp_poll(proxy_sock, 0)
        if poll_proxy == 1
            activity = 1
            let app_sock = net::tcp_accept(proxy_sock)
            if app_sock >= 0
                let peer_port = net::tcp_peer_port(app_sock)
                let proc_buf = "" + crypto::alloc_str(260)
                let route_vpn = alya_vpn_check_peer_route(local_port, peer_port, proc_buf, 256)
                let proc_name = resolver::extract_c_string(proc_buf)
                if len(proc_name) == 0
                    proc_name = "unknown"
                end

                let ok, host, port = parse_socks5_request(app_sock)
                if ok == 1
                    if proc_name == "unknown"
                        let inf_buf = "" + crypto::alloc_str(260)
                        let inf_res = alya_vpn_infer_process_from_host(host, inf_buf, 256)
                        if inf_res == 1
                            let inf_name = resolver::extract_c_string(inf_buf)
                            if len(inf_name) > 0
                                proc_name = inf_name
                            end
                        end
                    end

                    if host == "127.0.0.1" or host == "localhost" or host == "::1"
                        route_vpn = 0
                    else
                        let host_route = alya_vpn_should_route_host(host, port)
                        if host_route == 1
                            route_vpn = 1
                        else if host_route == 0
                            route_vpn = 0
                        end
                    end

                    if route_vpn != 0
                        if log_tunnel_traffic == 1
                            say("[TUNNEL] [" + proc_name + "] -> " + host + ":" + port + " (Channel " + next_channel_id + ")")
                        end
                        let res = alya_vpn_open_client_channel(vpn_sock, next_channel_id, host, port, app_sock)
                        if res < 0
                            net::tcp_close(app_sock)
                        else
                            next_channel_id += 1
                        end
                    else
                        if log_direct_traffic == 1
                            say("[DIRECT] [" + proc_name + "] -> " + host + ":" + port + " (Bypassing VPN)")
                        end
                        let res = alya_vpn_open_direct(app_sock, host, port)
                        if res < 0
                            net::tcp_close(app_sock)
                        end
                    end
                else
                    net::tcp_close(app_sock)
                end
            end
        end

        # 2. Check VPN Tunnel (High-speed zero-copy native pump in C)
        let vpn_res = alya_vpn_pump_client_vpn(vpn_sock)
        if vpn_res < 0 or vpn_res == 4294967295 or vpn_res == -1
            if kill_switch == 1 and auto_reconnect == 0
                say("[KILL-SWITCH] VPN server connection lost. Traffic blocked immediately to prevent IP leak.")
                break
            end

            if auto_reconnect == 1
                say("[WARN] VPN server connection lost. Attempting auto-reconnect...")
                net::tcp_close(vpn_sock)
                alya_vpn_ch_clear()
                let attempt = 1
                let reconnected = 0
                while attempt <= reconnect_attempts or reconnect_attempts == 0
                    let attempt_str = "" + attempt
                    if reconnect_attempts > 0
                        attempt_str = attempt_str + "/" + reconnect_attempts
                    end
                    say("[INFO] Reconnecting to VPN server (attempt " + attempt_str + " in " + (reconnect_interval_ms / 1000) + "s)...")
                    alya_vpn_sleep_ms(reconnect_interval_ms)
                    if alya_vpn_is_stop_requested() == 1
                        break
                    end
                    vpn_sock = net::tcp_connect(server_host, server_port)
                    if vpn_sock >= 0
                        reconnected = 1
                        say("[INFO] Encrypted VPN tunnel re-established successfully!")
                        break
                    end
                    attempt += 1
                end
                if reconnected == 0
                    if kill_switch == 1
                        say("[KILL-SWITCH] Max reconnect attempts reached. Traffic blocked.")
                    else
                        say("[ERROR] Max reconnect attempts reached. Exiting.")
                    end
                    break
                end
            else
                say("[ERROR] VPN server connection lost. Exiting.")
                break
            end
        else if vpn_res > 0
            activity = 1
        end

        # 3. Check Direct Connections (Bypass mode) — native zero-copy C pump
        if alya_vpn_direct_count() > 0
            if alya_vpn_pump_direct() == 1
                activity = 1
            end
        end

        # 4. Periodic statistics report
        if show_stats == 1
            let now_ms = alya_vpn_get_time_ms()
            if (now_ms - last_stats_ms) >= (stats_interval_sec * 1000)
                say("[STATS] " + alya_vpn_stats_get_summary())
                last_stats_ms = now_ms
            end
        end

        # Sleep 1ms only when idle — prevents busy-wait without adding latency
        if activity == 0
            alya_vpn_sleep_ms(1)
        end
    end

    net::tcp_close(vpn_sock)
    net::tcp_close(proxy_sock)
    tpool::thread_pool_shutdown()

    if auto_sys_proxy == 1
        alya_vpn_set_system_proxy(0, 0)
        say("[INFO] System Proxy restored.")
    end
    return 0
end
