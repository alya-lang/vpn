# Alya VPN - Next-Gen Split-Tunneling Encrypted VPN
# CLI Entry point supporting Server, Client (SOCKS5 + Split Tunneling), and Diagnostic commands

import "./server/forwarder.alya" as server
import "./client/local_proxy.alya" as client
import "./client/resolver.alya" as resolver
import "./client/router.alya" as router
import "./common/crypto.alya" as crypto
import "./common/protocol.alya" as proto

function print_banner()
    say("=================================================================")
    say("            A L Y A   V P N   T U N N E L   (v0.2.11)            ")
    say("   High-Performance ChaCha20-Poly1305 Split-Tunneling Network    ")
    say("=================================================================")
end

function print_usage()
    print_banner()
    say("Usage: alya run src/main.alya -- <command> [options]\n")
    say("Commands:")
    say("  server                      Start the remote VPN tunnel server")
    say("    --bind <ip>               Bind address (default: 0.0.0.0)")
    say("    --port <port>             Listen port (default: 51822)")
    say("    --pass <secret>           Shared passphrase for AEAD encryption")
    say("    --protocol <mode>         Forwarded payloads: tcp, udp or both (default: both)")
    say("    --backlog <N>             Pending connection queue (default: 128)")
    say("    --max-clients <N>         Max concurrent clients (default: 100)")
    say("    --block-lan <bool>        SSRF protection: block internal LAN destinations (default: true)")
    say("    --blocked-ports <p1,p2>   Blocked destination ports (e.g. 25, 465, 587)")
    say("    --idle-timeout <sec>      Channel idle timeout in seconds (default: 300, 0=off)")
    say("    --tcp-nodelay <bool>      Disable Nagle algorithm for low latency (default: true)")
    say("    --log-connections <bool>  Log each forward channel event (default: true)")
    say("    --quiet                   Disable forward channel logging")
    say("    --stats                   Display periodic traffic stats")
    say("    --stats-interval <sec>    Traffic stats reporting interval (default: 60)")
    say("    --crypto-threads <N>      Crypto worker thread count (default: 2)")
    say("    --io-threads <N>          I/O worker thread count (default: 4)\n")
    say("  client                      Start the local client SOCKS5 proxy")
    say("    --bind <ip>               Local bind address (default: 127.0.0.1)")
    say("    --server <host>           Remote VPN server host (default: 127.0.0.1)")
    say("    --port <port>             Remote VPN server port (default: 51822)")
    say("    --proxy <port>            Local SOCKS5 proxy port (default: 1080)")
    say("    --pass <secret>           Shared passphrase for AEAD encryption")
    say("    --protocol <mode>         Forwarded payloads: tcp, udp or both (default: both)")
    say("    --mode <all|inc|exc>      Split-tunnel mode:")
    say("                                all: Route everything via VPN")
    say("                                inc: ONLY listed apps/domains use VPN")
    say("                                exc: Listed apps/domains BYPASS VPN (default)")
    say("    --apps <a,b,c>            Comma-separated app names or patterns")
    say("                              e.g. 'discord,steamwebhelper.exe,*torrent*'")
    say("    --domains <d1,d2>         Comma-separated domain patterns (e.g. '*.discord.com')")
    say("    --bypass-lan <bool>       Bypass private LAN targets (default: true)")
    say("    --kill-switch <bool>      Block traffic if VPN connection drops (default: false)")
    say("    --idle-timeout <sec>      Channel idle timeout in seconds (default: 300, 0=off)")
    say("    --ping-interval <sec>     Keep-alive ping interval in seconds (default: 30)")
    say("    --auto-reconnect <bool>   Auto reconnect on tunnel drops (default: true)")
    say("    --reconnect-attempts <N>  Max reconnect attempts (default: 10, 0=infinite)")
    say("    --reconnect-interval <ms> Delay between attempts in ms (default: 3000)")
    say("    --handshake-timeout <ms>  SOCKS5 handshake timeout in ms (default: 3000)")
    say("    --connect-timeout <ms>    Direct connect timeout in ms (default: 3000)")
    say("    --tcp-nodelay <bool>      Disable Nagle algorithm for low latency (default: true)")
    say("    --log-direct              Show direct bypass connections in log")
    say("    --quiet-direct            Hide direct bypass connections from log (default)")
    say("    --stats                   Display periodic traffic stats")
    say("    --stats-interval <sec>    Traffic stats reporting interval (default: 60)")
    say("    --crypto-threads <N>      Crypto worker thread count (default: 1)")
    say("    --io-threads <N>          I/O worker thread count (default: 2)")
    say("    --auto-proxy              Automatically configure OS system proxy")
    say("    --no-system-proxy         Do not configure system proxy automatically\n")
    say("  check-port <port>           Diagnostic: inspect process owning local port")
    say("  benchmark                   Run ChaCha20-Poly1305 encryption benchmark\n")
end

# Trims whitespace and quotes from start and end of string (preserves spaces inside)
function strip_val(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start = 0
    while start < slen
        let ch = char_at(s, start)
        if ch != " " and ch != "\t" and ch != "\"" and ch != "'" and ch != "\r" and ch != "\n"
            break
        end
        start += 1
    end
    let end_idx = slen - 1
    while end_idx >= start
        let ch = char_at(s, end_idx)
        if ch != " " and ch != "\t" and ch != "\"" and ch != "'" and ch != "\r" and ch != "\n" and ch != ","
            break
        end
        end_idx -= 1
    end
    if start > end_idx
        return ""
    end
    return s.substring(start, end_idx - start + 1)
end

# Loads client configuration from config/client.toml
function load_client_config(config_path)
    if file_exists(config_path) == 0
        return null
    end
    let content = read_file(config_path)
    let lines = proto::split_string(content, "\n")
    let cfg = {
        "server_host": "127.0.0.1",
        "server_port": 51822,
        "local_port": 1080,
        "bind_address": "127.0.0.1",
        "passphrase": "change_me_to_a_secure_shared_passphrase_2026",
        "protocol": "both",
        "mode": "exclude",
        "system_proxy": "true",
        "auto_sys_proxy": "true",
        "kill_switch": "false",
        "idle_timeout_sec": 300,
        "ping_interval_sec": 30,
        "show_stats": "false",
        "stats_interval_sec": 60,
        "crypto_threads": 1,
        "io_threads": 2,
        "tunnel_dns": "true",
        "bypass_lan": "true",
        "auto_reconnect": "true",
        "reconnect_attempts": 10,
        "reconnect_interval_ms": 3000,
        "handshake_timeout_ms": 3000,
        "connect_timeout_ms": 3000,
        "tcp_nodelay": "true",
        "log_tunnel_traffic": "true",
        "log_direct_traffic": "false",
        "apps": [],
        "domains": [],
        "dns_servers": [],
        "dns_resolvers": [],
        "bypass_lan_ranges": []
    }
    let current_array = ""
    let i = 0
    while i < len(lines)
        let line = lines[i]
        let hash_idx = proto::find_char(line, "#")
        if hash_idx >= 0
            line = line.substring(0, hash_idx)
        end
        let eq_idx = proto::find_char(line, "=")
        if eq_idx >= 0
            let key = strip_val(line.substring(0, eq_idx))
            let val = line.substring(eq_idx + 1)
            if key == "server_host"
                cfg["server_host"] = strip_val(val)
            else if key == "server_port"
                cfg["server_port"] = proto::parse_number(strip_val(val))
            else if key == "local_proxy_port" or key == "local_port"
                cfg["local_port"] = proto::parse_number(strip_val(val))
            else if key == "bind_address" or key == "bind_ip"
                cfg["bind_address"] = strip_val(val)
            else if key == "passphrase"
                cfg["passphrase"] = strip_val(val)
            else if key == "protocol" or key == "forward_protocol"
                cfg["protocol"] = strip_val(val)
            else if key == "mode"
                cfg["mode"] = strip_val(val)
            else if key == "system_proxy" or key == "auto_system_proxy" or key == "auto_sys_proxy"
                cfg["system_proxy"] = strip_val(val)
                cfg["auto_sys_proxy"] = strip_val(val)
            else if key == "kill_switch"
                cfg["kill_switch"] = strip_val(val)
            else if key == "idle_timeout_sec" or key == "idle_timeout"
                cfg["idle_timeout_sec"] = proto::parse_number(strip_val(val))
            else if key == "ping_interval_sec" or key == "ping_interval"
                cfg["ping_interval_sec"] = proto::parse_number(strip_val(val))
            else if key == "show_stats" or key == "stats"
                cfg["show_stats"] = strip_val(val)
            else if key == "stats_interval_sec" or key == "stats_interval"
                cfg["stats_interval_sec"] = proto::parse_number(strip_val(val))
            else if key == "crypto_threads"
                cfg["crypto_threads"] = proto::parse_number(strip_val(val))
            else if key == "io_threads"
                cfg["io_threads"] = proto::parse_number(strip_val(val))
            else if key == "tunnel_dns" or key == "route_dns"
                cfg["tunnel_dns"] = strip_val(val)
            else if key == "bypass_lan" or key == "local_network_bypass"
                cfg["bypass_lan"] = strip_val(val)
            else if key == "auto_reconnect"
                cfg["auto_reconnect"] = strip_val(val)
            else if key == "reconnect_attempts" or key == "max_reconnect_attempts"
                cfg["reconnect_attempts"] = proto::parse_number(strip_val(val))
            else if key == "reconnect_interval_ms" or key == "reconnect_interval"
                cfg["reconnect_interval_ms"] = proto::parse_number(strip_val(val))
            else if key == "handshake_timeout_ms" or key == "handshake_timeout"
                cfg["handshake_timeout_ms"] = proto::parse_number(strip_val(val))
            else if key == "connect_timeout_ms" or key == "connect_timeout"
                cfg["connect_timeout_ms"] = proto::parse_number(strip_val(val))
            else if key == "tcp_nodelay" or key == "nodelay"
                cfg["tcp_nodelay"] = strip_val(val)
            else if key == "log_tunnel_traffic"
                cfg["log_tunnel_traffic"] = strip_val(val)
            else if key == "log_direct_traffic"
                cfg["log_direct_traffic"] = strip_val(val)
            else if key == "apps" or key == "domains" or key == "dns_servers" or key == "dns_resolvers" or key == "bypass_lan_ranges"
                current_array = key
                let bracket_open = proto::find_char(val, "[")
                let bracket_close = proto::find_char(val, "]")
                if bracket_open >= 0 and bracket_close > bracket_open
                    let inside = val.substring(bracket_open + 1, bracket_close - bracket_open - 1)
                    let items = proto::split_string(inside, ",")
                    let k = 0
                    while k < len(items)
                        let it = strip_val(items[k])
                        if len(it) > 0
                            cfg[current_array].push(it)
                        end
                        k += 1
                    end
                    current_array = ""
                else if proto::find_char(val, "]") >= 0
                    current_array = ""
                end
            end
        else if len(current_array) > 0
            if proto::find_char(line, "]") >= 0
                let bracket_idx = proto::find_char(line, "]")
                let before_bracket = line.substring(0, bracket_idx)
                let items = proto::split_string(before_bracket, ",")
                let k = 0
                while k < len(items)
                    let it = strip_val(items[k])
                    if len(it) > 0
                        cfg[current_array].push(it)
                    end
                    k += 1
                end
                current_array = ""
            else
                let items = proto::split_string(line, ",")
                let k = 0
                while k < len(items)
                    let it = strip_val(items[k])
                    if len(it) > 0
                        cfg[current_array].push(it)
                    end
                    k += 1
                end
            end
        end
        i += 1
    end
    return cfg
end

# Loads server configuration from config/server.toml
function load_server_config(config_path)
    if file_exists(config_path) == 0
        return null
    end
    let content = read_file(config_path)
    let lines = proto::split_string(content, "\n")
    let cfg = {
        "bind_address": "0.0.0.0",
        "port": 51822,
        "passphrase": "change_me_to_a_secure_shared_passphrase_2026",
        "protocol": "both",
        "crypto_threads": 2,
        "io_threads": 4,
        "backlog": 128,
        "max_clients": 100,
        "block_lan_destinations": "true",
        "blocked_ports": [],
        "idle_timeout_sec": 300,
        "show_stats": "false",
        "stats_interval_sec": 60,
        "tcp_nodelay": "true",
        "log_connections": "true",
        "log_client_events": "true",
        "allowed_clients": []
    }
    let current_array = ""
    let i = 0
    while i < len(lines)
        let line = lines[i]
        let hash_idx = proto::find_char(line, "#")
        if hash_idx >= 0
            line = line.substring(0, hash_idx)
        end
        let eq_idx = proto::find_char(line, "=")
        if eq_idx >= 0
            let key = strip_val(line.substring(0, eq_idx))
            let val = line.substring(eq_idx + 1)
            if key == "port"
                cfg["port"] = proto::parse_number(strip_val(val))
            else if key == "bind_address" or key == "bind_ip"
                cfg["bind_address"] = strip_val(val)
            else if key == "passphrase"
                cfg["passphrase"] = strip_val(val)
            else if key == "protocol" or key == "forward_protocol"
                cfg["protocol"] = strip_val(val)
            else if key == "crypto_threads"
                cfg["crypto_threads"] = proto::parse_number(strip_val(val))
            else if key == "io_threads"
                cfg["io_threads"] = proto::parse_number(strip_val(val))
            else if key == "backlog"
                cfg["backlog"] = proto::parse_number(strip_val(val))
            else if key == "max_clients"
                cfg["max_clients"] = proto::parse_number(strip_val(val))
            else if key == "block_lan_destinations" or key == "block_lan" or key == "ssrf_protection"
                cfg["block_lan_destinations"] = strip_val(val)
            else if key == "idle_timeout_sec" or key == "idle_timeout"
                cfg["idle_timeout_sec"] = proto::parse_number(strip_val(val))
            else if key == "show_stats" or key == "stats"
                cfg["show_stats"] = strip_val(val)
            else if key == "stats_interval_sec" or key == "stats_interval"
                cfg["stats_interval_sec"] = proto::parse_number(strip_val(val))
            else if key == "tcp_nodelay" or key == "nodelay"
                cfg["tcp_nodelay"] = strip_val(val)
            else if key == "log_connections"
                cfg["log_connections"] = strip_val(val)
            else if key == "log_client_events"
                cfg["log_client_events"] = strip_val(val)
            else if key == "allowed_clients" or key == "whitelist" or key == "blocked_ports"
                current_array = key
                let bracket_open = proto::find_char(val, "[")
                let bracket_close = proto::find_char(val, "]")
                if bracket_open >= 0 and bracket_close > bracket_open
                    let inside = val.substring(bracket_open + 1, bracket_close - bracket_open - 1)
                    let items = proto::split_string(inside, ",")
                    let k = 0
                    while k < len(items)
                        let it = strip_val(items[k])
                        if len(it) > 0
                            if current_array == "blocked_ports"
                                cfg["blocked_ports"].push(proto::parse_number(it))
                            else
                                cfg["allowed_clients"].push(it)
                            end
                        end
                        k += 1
                    end
                    current_array = ""
                else if proto::find_char(val, "]") >= 0
                    current_array = ""
                end
            end
        else if len(current_array) > 0
            if proto::find_char(line, "]") >= 0
                let bracket_idx = proto::find_char(line, "]")
                let before_bracket = line.substring(0, bracket_idx)
                let items = proto::split_string(before_bracket, ",")
                let k = 0
                while k < len(items)
                    let it = strip_val(items[k])
                    if len(it) > 0
                        if current_array == "blocked_ports"
                            cfg["blocked_ports"].push(proto::parse_number(it))
                        else
                            cfg["allowed_clients"].push(it)
                        end
                    end
                    k += 1
                end
                current_array = ""
            else
                let items = proto::split_string(line, ",")
                let k = 0
                while k < len(items)
                    let it = strip_val(items[k])
                    if len(it) > 0
                        if current_array == "blocked_ports"
                            cfg["blocked_ports"].push(proto::parse_number(it))
                        else
                            cfg["allowed_clients"].push(it)
                        end
                    end
                    k += 1
                end
            end
        end
        i += 1
    end
    return cfg
end

function main()
    let args_list = args()
    if len(args_list) < 1
        print_usage()
        return 0
    end

    let cmd = args_list[0]

    # --- COMMAND: SERVER ---
    if cmd == "server"
        let bind_address = "0.0.0.0"
        let port = 51822
        let pass = "change_me_to_a_secure_shared_passphrase_2026"
        let forward_protocol_str = "both"
        let crypto_threads = 2
        let io_threads = 4
        let backlog = 128
        let max_clients = 100
        let block_lan = 1
        let blocked_ports = []
        let idle_timeout_sec = 300
        let show_stats = 0
        let stats_interval_sec = 60
        let tcp_nodelay = 1
        let log_connections = 1
        let log_client_events = 1
        let allowed_clients = []

        # Check default config/server.toml if exists
        let srv_cfg_file = "config/server.toml"
        let file_cfg = load_server_config(srv_cfg_file)
        if file_cfg != null
            if file_cfg["bind_address"] != null
                bind_address = file_cfg["bind_address"]
            end
            port = file_cfg["port"]
            pass = file_cfg["passphrase"]
            if file_cfg["protocol"] != null and len(file_cfg["protocol"]) > 0
                forward_protocol_str = file_cfg["protocol"]
            end
            crypto_threads = file_cfg["crypto_threads"]
            io_threads = file_cfg["io_threads"]
            backlog = file_cfg["backlog"]
            max_clients = file_cfg["max_clients"]
            if file_cfg["block_lan_destinations"] == "false" or file_cfg["block_lan_destinations"] == "0"
                block_lan = 0
            end
            if file_cfg["idle_timeout_sec"] != null and file_cfg["idle_timeout_sec"] >= 0
                idle_timeout_sec = file_cfg["idle_timeout_sec"]
            end
            if file_cfg["show_stats"] == "true" or file_cfg["show_stats"] == "1"
                show_stats = 1
            end
            if file_cfg["stats_interval_sec"] != null and file_cfg["stats_interval_sec"] > 0
                stats_interval_sec = file_cfg["stats_interval_sec"]
            end
            if file_cfg["tcp_nodelay"] == "false" or file_cfg["tcp_nodelay"] == "0"
                tcp_nodelay = 0
            end
            if file_cfg["log_connections"] == "false" or file_cfg["log_connections"] == "0"
                log_connections = 0
            end
            if file_cfg["log_client_events"] == "false" or file_cfg["log_client_events"] == "0"
                log_client_events = 0
            end
            if len(file_cfg["allowed_clients"]) > 0
                allowed_clients = file_cfg["allowed_clients"]
            end
            if len(file_cfg["blocked_ports"]) > 0
                blocked_ports = file_cfg["blocked_ports"]
            end
        end

        let i = 1
        while i < len(args_list)
            if args_list[i] == "--config" and i + 1 < len(args_list)
                let custom_cfg = load_server_config(args_list[i + 1])
                if custom_cfg != null
                    if custom_cfg["bind_address"] != null
                        bind_address = custom_cfg["bind_address"]
                    end
                    port = custom_cfg["port"]
                    pass = custom_cfg["passphrase"]
                    if custom_cfg["protocol"] != null and len(custom_cfg["protocol"]) > 0
                        forward_protocol_str = custom_cfg["protocol"]
                    end
                    crypto_threads = custom_cfg["crypto_threads"]
                    io_threads = custom_cfg["io_threads"]
                    backlog = custom_cfg["backlog"]
                    max_clients = custom_cfg["max_clients"]
                    if custom_cfg["block_lan_destinations"] == "false" or custom_cfg["block_lan_destinations"] == "0"
                        block_lan = 0
                    end
                    if custom_cfg["idle_timeout_sec"] != null and custom_cfg["idle_timeout_sec"] >= 0
                        idle_timeout_sec = custom_cfg["idle_timeout_sec"]
                    end
                    if custom_cfg["show_stats"] == "true" or custom_cfg["show_stats"] == "1"
                        show_stats = 1
                    end
                    if custom_cfg["stats_interval_sec"] != null and custom_cfg["stats_interval_sec"] > 0
                        stats_interval_sec = custom_cfg["stats_interval_sec"]
                    end
                    if custom_cfg["tcp_nodelay"] == "false" or custom_cfg["tcp_nodelay"] == "0"
                        tcp_nodelay = 0
                    end
                    if custom_cfg["log_connections"] == "false" or custom_cfg["log_connections"] == "0"
                        log_connections = 0
                    end
                    if custom_cfg["log_client_events"] == "false" or custom_cfg["log_client_events"] == "0"
                        log_client_events = 0
                    end
                    if len(custom_cfg["allowed_clients"]) > 0
                        allowed_clients = custom_cfg["allowed_clients"]
                    end
                    if len(custom_cfg["blocked_ports"]) > 0
                        blocked_ports = custom_cfg["blocked_ports"]
                    end
                end
                i += 2
            else if (args_list[i] == "--bind" or args_list[i] == "--bind-address") and i + 1 < len(args_list)
                bind_address = args_list[i + 1]
                i += 2
            else if args_list[i] == "--port" and i + 1 < len(args_list)
                port = proto::parse_number(args_list[i + 1])
                i += 2
            else if (args_list[i] == "--protocol" or args_list[i] == "--proto") and i + 1 < len(args_list)
                forward_protocol_str = args_list[i + 1]
                i += 2
            else if args_list[i] == "--pass" and i + 1 < len(args_list)
                pass = args_list[i + 1]
                i += 2
            else if args_list[i] == "--backlog" and i + 1 < len(args_list)
                backlog = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--max-clients" and i + 1 < len(args_list)
                max_clients = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--no-block-lan"
                block_lan = 0
                i += 1
            else if args_list[i] == "--block-lan"
                block_lan = 1
                i += 1
            else if args_list[i] == "--blocked-ports" and i + 1 < len(args_list)
                let raw_bp = proto::split_string(args_list[i + 1], ",")
                let k = 0
                while k < len(raw_bp)
                    let p_str = strip_val(raw_bp[k])
                    if len(p_str) > 0
                        blocked_ports.push(proto::parse_number(p_str))
                    end
                    k += 1
                end
                i += 2
            else if args_list[i] == "--idle-timeout" and i + 1 < len(args_list)
                idle_timeout_sec = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--stats"
                show_stats = 1
                i += 1
            else if args_list[i] == "--stats-interval" and i + 1 < len(args_list)
                stats_interval_sec = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--tcp-nodelay" and i + 1 < len(args_list)
                let nd = lower(args_list[i + 1])
                if nd == "false" or nd == "0"
                    tcp_nodelay = 0
                else
                    tcp_nodelay = 1
                end
                i += 2
            else if args_list[i] == "--log-connections" and i + 1 < len(args_list)
                let lc = lower(args_list[i + 1])
                if lc == "false" or lc == "0"
                    log_connections = 0
                else
                    log_connections = 1
                end
                i += 2
            else if args_list[i] == "--quiet" or args_list[i] == "-q"
                log_connections = 0
                i += 1
            else if args_list[i] == "--crypto-threads" and i + 1 < len(args_list)
                crypto_threads = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--io-threads" and i + 1 < len(args_list)
                io_threads = proto::parse_number(args_list[i + 1])
                i += 2
            else
                i += 1
            end
        end

        print_banner()
        let server_cfg = {
            "bind_address": bind_address,
            "port": port,
            "passphrase": pass,
            "forward_protocol": proto::parse_forward_protocol(forward_protocol_str) as int,
            "crypto_threads": crypto_threads,
            "io_threads": io_threads,
            "backlog": backlog,
            "max_clients": max_clients,
            "block_lan_destinations": block_lan,
            "blocked_ports": blocked_ports,
            "idle_timeout_sec": idle_timeout_sec,
            "show_stats": show_stats,
            "stats_interval_sec": stats_interval_sec,
            "tcp_nodelay": tcp_nodelay,
            "log_connections": log_connections,
            "log_client_events": log_client_events,
            "allowed_clients": allowed_clients
        }
        server::vpn_run_server(server_cfg, server::vpn_client_thread)
        return 0
    end

    # --- COMMAND: CLIENT ---
    if cmd == "client"
        let bind_address = "127.0.0.1"
        let srv_host = "127.0.0.1"
        let srv_port = 51822
        let proxy_port = 1080
        let pass = "change_me_to_a_secure_shared_passphrase_2026"
        let split_mode = router::mode_exclude() # Default blacklist
        let forward_protocol_str = "both"
        let app_list = ["Speedtest", "Discord", "Chrome", "curl"]
        let domain_list = []
        let auto_sys_proxy = 0
        let tunnel_dns = 1
        let crypto_threads = 1
        let io_threads = 2
        let dns_servers = []
        let dns_resolvers = []
        let bypass_lan = 1
        let bypass_lan_ranges = []
        let auto_reconnect = 1
        let reconnect_attempts = 10
        let reconnect_interval_ms = 3000
        let handshake_timeout_ms = 3000
        let connect_timeout_ms = 3000
        let idle_timeout_sec = 300
        let ping_interval_sec = 30
        let kill_switch = 0
        let show_stats = 0
        let stats_interval_sec = 60
        let tcp_nodelay = 1
        let log_tunnel_traffic = 1
        let log_direct_traffic = 0

        # 1. Automatically load config/client.toml if present
        let cfg_file = "config/client.toml"
        let file_cfg = load_client_config(cfg_file)
        if file_cfg != null
            srv_host = file_cfg["server_host"]
            srv_port = file_cfg["server_port"]
            proxy_port = file_cfg["local_port"]
            if file_cfg["bind_address"] != null
                bind_address = file_cfg["bind_address"]
            end
            pass = file_cfg["passphrase"]
            if file_cfg["protocol"] != null and len(file_cfg["protocol"]) > 0
                forward_protocol_str = file_cfg["protocol"]
            end
            crypto_threads = file_cfg["crypto_threads"]
            io_threads = file_cfg["io_threads"]
            split_mode = router::parse_split_mode(file_cfg["mode"], split_mode)
            if file_cfg["system_proxy"] == "true" or file_cfg["system_proxy"] == "1" or file_cfg["auto_sys_proxy"] == "true" or file_cfg["auto_sys_proxy"] == "1"
                auto_sys_proxy = 1
            else if file_cfg["system_proxy"] == "false" or file_cfg["system_proxy"] == "0" or file_cfg["auto_sys_proxy"] == "false" or file_cfg["auto_sys_proxy"] == "0"
                auto_sys_proxy = 0
            end
            if file_cfg["kill_switch"] == "true" or file_cfg["kill_switch"] == "1"
                kill_switch = 1
            else if file_cfg["kill_switch"] == "false" or file_cfg["kill_switch"] == "0"
                kill_switch = 0
            end
            if file_cfg["tunnel_dns"] == "false" or file_cfg["tunnel_dns"] == "0"
                tunnel_dns = 0
            end
            if file_cfg["bypass_lan"] == "false" or file_cfg["bypass_lan"] == "0"
                bypass_lan = 0
            end
            if file_cfg["auto_reconnect"] == "false" or file_cfg["auto_reconnect"] == "0"
                auto_reconnect = 0
            end
            if file_cfg["tcp_nodelay"] == "false" or file_cfg["tcp_nodelay"] == "0"
                tcp_nodelay = 0
            end
            if file_cfg["log_tunnel_traffic"] == "false" or file_cfg["log_tunnel_traffic"] == "0"
                log_tunnel_traffic = 0
            end
            if file_cfg["log_direct_traffic"] == "true" or file_cfg["log_direct_traffic"] == "1"
                log_direct_traffic = 1
            end
            if file_cfg["show_stats"] == "true" or file_cfg["show_stats"] == "1"
                show_stats = 1
            end
            if file_cfg["stats_interval_sec"] != null and file_cfg["stats_interval_sec"] > 0
                stats_interval_sec = file_cfg["stats_interval_sec"]
            end
            if file_cfg["idle_timeout_sec"] != null and file_cfg["idle_timeout_sec"] >= 0
                idle_timeout_sec = file_cfg["idle_timeout_sec"]
            end
            if file_cfg["ping_interval_sec"] != null and file_cfg["ping_interval_sec"] >= 0
                ping_interval_sec = file_cfg["ping_interval_sec"]
            end
            if file_cfg["reconnect_attempts"] != null and file_cfg["reconnect_attempts"] >= 0
                reconnect_attempts = file_cfg["reconnect_attempts"]
            end
            if file_cfg["reconnect_interval_ms"] != null and file_cfg["reconnect_interval_ms"] > 0
                reconnect_interval_ms = file_cfg["reconnect_interval_ms"]
            end
            if file_cfg["handshake_timeout_ms"] != null and file_cfg["handshake_timeout_ms"] > 0
                handshake_timeout_ms = file_cfg["handshake_timeout_ms"]
            end
            if file_cfg["connect_timeout_ms"] != null and file_cfg["connect_timeout_ms"] > 0
                connect_timeout_ms = file_cfg["connect_timeout_ms"]
            end
            if len(file_cfg["apps"]) > 0
                app_list = file_cfg["apps"]
            end
            if len(file_cfg["domains"]) > 0
                domain_list = file_cfg["domains"]
            end
            if len(file_cfg["dns_servers"]) > 0
                dns_servers = file_cfg["dns_servers"]
            end
            if len(file_cfg["dns_resolvers"]) > 0
                dns_resolvers = file_cfg["dns_resolvers"]
            end
            if len(file_cfg["bypass_lan_ranges"]) > 0
                bypass_lan_ranges = file_cfg["bypass_lan_ranges"]
            end
        end

        let i = 1
        while i < len(args_list)
            if args_list[i] == "--config" and i + 1 < len(args_list)
                let custom_cfg = load_client_config(args_list[i + 1])
                if custom_cfg != null
                    srv_host = custom_cfg["server_host"]
                    srv_port = custom_cfg["server_port"]
                    proxy_port = custom_cfg["local_port"]
                    if custom_cfg["bind_address"] != null
                        bind_address = custom_cfg["bind_address"]
                    end
                    pass = custom_cfg["passphrase"]
                    if custom_cfg["protocol"] != null and len(custom_cfg["protocol"]) > 0
                        forward_protocol_str = custom_cfg["protocol"]
                    end
                    crypto_threads = custom_cfg["crypto_threads"]
                    io_threads = custom_cfg["io_threads"]
                    split_mode = router::parse_split_mode(custom_cfg["mode"], split_mode)
                    if custom_cfg["system_proxy"] == "true" or custom_cfg["system_proxy"] == "1" or custom_cfg["auto_sys_proxy"] == "true" or custom_cfg["auto_sys_proxy"] == "1"
                        auto_sys_proxy = 1
                    else if custom_cfg["system_proxy"] == "false" or custom_cfg["system_proxy"] == "0" or custom_cfg["auto_sys_proxy"] == "false" or custom_cfg["auto_sys_proxy"] == "0"
                        auto_sys_proxy = 0
                    end
                    if custom_cfg["kill_switch"] == "true" or custom_cfg["kill_switch"] == "1"
                        kill_switch = 1
                    else if custom_cfg["kill_switch"] == "false" or custom_cfg["kill_switch"] == "0"
                        kill_switch = 0
                    end
                    if custom_cfg["tunnel_dns"] == "false" or custom_cfg["tunnel_dns"] == "0"
                        tunnel_dns = 0
                    end
                    if custom_cfg["bypass_lan"] == "false" or custom_cfg["bypass_lan"] == "0"
                        bypass_lan = 0
                    end
                    if custom_cfg["auto_reconnect"] == "false" or custom_cfg["auto_reconnect"] == "0"
                        auto_reconnect = 0
                    end
                    if custom_cfg["tcp_nodelay"] == "false" or custom_cfg["tcp_nodelay"] == "0"
                        tcp_nodelay = 0
                    end
                    if custom_cfg["log_tunnel_traffic"] == "false" or custom_cfg["log_tunnel_traffic"] == "0"
                        log_tunnel_traffic = 0
                    end
                    if custom_cfg["log_direct_traffic"] == "true" or custom_cfg["log_direct_traffic"] == "1"
                        log_direct_traffic = 1
                    end
                    if custom_cfg["show_stats"] == "true" or custom_cfg["show_stats"] == "1"
                        show_stats = 1
                    end
                    if custom_cfg["stats_interval_sec"] != null and custom_cfg["stats_interval_sec"] > 0
                        stats_interval_sec = custom_cfg["stats_interval_sec"]
                    end
                    if custom_cfg["idle_timeout_sec"] != null and custom_cfg["idle_timeout_sec"] >= 0
                        idle_timeout_sec = custom_cfg["idle_timeout_sec"]
                    end
                    if custom_cfg["ping_interval_sec"] != null and custom_cfg["ping_interval_sec"] >= 0
                        ping_interval_sec = custom_cfg["ping_interval_sec"]
                    end
                    if custom_cfg["reconnect_attempts"] != null and custom_cfg["reconnect_attempts"] >= 0
                        reconnect_attempts = custom_cfg["reconnect_attempts"]
                    end
                    if custom_cfg["reconnect_interval_ms"] != null and custom_cfg["reconnect_interval_ms"] > 0
                        reconnect_interval_ms = custom_cfg["reconnect_interval_ms"]
                    end
                    if custom_cfg["handshake_timeout_ms"] != null and custom_cfg["handshake_timeout_ms"] > 0
                        handshake_timeout_ms = custom_cfg["handshake_timeout_ms"]
                    end
                    if custom_cfg["connect_timeout_ms"] != null and custom_cfg["connect_timeout_ms"] > 0
                        connect_timeout_ms = custom_cfg["connect_timeout_ms"]
                    end
                    if len(custom_cfg["apps"]) > 0
                        app_list = custom_cfg["apps"]
                    end
                    if len(custom_cfg["domains"]) > 0
                        domain_list = custom_cfg["domains"]
                    end
                    if len(custom_cfg["dns_servers"]) > 0
                        dns_servers = custom_cfg["dns_servers"]
                    end
                    if len(custom_cfg["dns_resolvers"]) > 0
                        dns_resolvers = custom_cfg["dns_resolvers"]
                    end
                    if len(custom_cfg["bypass_lan_ranges"]) > 0
                        bypass_lan_ranges = custom_cfg["bypass_lan_ranges"]
                    end
                end
                i += 2
            else if (args_list[i] == "--bind" or args_list[i] == "--bind-address") and i + 1 < len(args_list)
                bind_address = args_list[i + 1]
                i += 2
            else if args_list[i] == "--server" and i + 1 < len(args_list)
                srv_host = args_list[i + 1]
                i += 2
            else if args_list[i] == "--port" and i + 1 < len(args_list)
                srv_port = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--proxy" and i + 1 < len(args_list)
                proxy_port = proto::parse_number(args_list[i + 1])
                i += 2
            else if (args_list[i] == "--protocol" or args_list[i] == "--proto") and i + 1 < len(args_list)
                forward_protocol_str = args_list[i + 1]
                i += 2
            else if args_list[i] == "--pass" and i + 1 < len(args_list)
                pass = args_list[i + 1]
                i += 2
            else if args_list[i] == "--mode" and i + 1 < len(args_list)
                split_mode = router::parse_split_mode(args_list[i + 1], split_mode)
                i += 2
            else if args_list[i] == "--apps" and i + 1 < len(args_list)
                let raw_apps = proto::split_string(args_list[i + 1], ",")
                let clean_apps = []
                let k = 0
                while k < len(raw_apps)
                    let it = strip_val(raw_apps[k])
                    if len(it) > 0
                        clean_apps.push(it)
                    end
                    k += 1
                end
                app_list = clean_apps
                i += 2
            else if args_list[i] == "--domains" and i + 1 < len(args_list)
                let raw_dms = proto::split_string(args_list[i + 1], ",")
                let clean_dms = []
                let k = 0
                while k < len(raw_dms)
                    let it = strip_val(raw_dms[k])
                    if len(it) > 0
                        clean_dms.push(it)
                    end
                    k += 1
                end
                domain_list = clean_dms
                i += 2
            else if args_list[i] == "--bypass-lan" and i + 1 < len(args_list)
                let bl = lower(args_list[i + 1])
                if bl == "false" or bl == "0"
                    bypass_lan = 0
                else
                    bypass_lan = 1
                end
                i += 2
            else if args_list[i] == "--no-bypass-lan"
                bypass_lan = 0
                i += 1
            else if args_list[i] == "--bypass-lan-ranges" and i + 1 < len(args_list)
                let raw_blr = proto::split_string(args_list[i + 1], ",")
                let k = 0
                while k < len(raw_blr)
                    let it = strip_val(raw_blr[k])
                    if len(it) > 0
                        bypass_lan_ranges.push(it)
                    end
                    k += 1
                end
                i += 2
            else if args_list[i] == "--kill-switch"
                kill_switch = 1
                i += 1
            else if args_list[i] == "--no-kill-switch"
                kill_switch = 0
                i += 1
            else if args_list[i] == "--idle-timeout" and i + 1 < len(args_list)
                idle_timeout_sec = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--ping-interval" and i + 1 < len(args_list)
                ping_interval_sec = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--stats"
                show_stats = 1
                i += 1
            else if args_list[i] == "--stats-interval" and i + 1 < len(args_list)
                stats_interval_sec = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--log-direct"
                log_direct_traffic = 1
                i += 1
            else if args_list[i] == "--quiet-direct"
                log_direct_traffic = 0
                i += 1
            else if args_list[i] == "--auto-reconnect" and i + 1 < len(args_list)
                let ar = lower(args_list[i + 1])
                if ar == "false" or ar == "0"
                    auto_reconnect = 0
                else
                    auto_reconnect = 1
                end
                i += 2
            else if args_list[i] == "--no-reconnect"
                auto_reconnect = 0
                i += 1
            else if args_list[i] == "--reconnect-attempts" and i + 1 < len(args_list)
                reconnect_attempts = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--reconnect-interval" and i + 1 < len(args_list)
                reconnect_interval_ms = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--handshake-timeout" and i + 1 < len(args_list)
                handshake_timeout_ms = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--connect-timeout" and i + 1 < len(args_list)
                connect_timeout_ms = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--tcp-nodelay" and i + 1 < len(args_list)
                let nd = lower(args_list[i + 1])
                if nd == "false" or nd == "0"
                    tcp_nodelay = 0
                else
                    tcp_nodelay = 1
                end
                i += 2
            else if args_list[i] == "--crypto-threads" and i + 1 < len(args_list)
                crypto_threads = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--io-threads" and i + 1 < len(args_list)
                io_threads = proto::parse_number(args_list[i + 1])
                i += 2
            else if args_list[i] == "--system-proxy" or args_list[i] == "--auto-proxy"
                auto_sys_proxy = 1
                i += 1
            else if args_list[i] == "--no-system-proxy" or args_list[i] == "--no-proxy"
                auto_sys_proxy = 0
                i += 1
            else if args_list[i] == "--no-dns"
                tunnel_dns = 0
                i += 1
            else if args_list[i] == "--tunnel-dns" and i + 1 < len(args_list)
                let td = lower(args_list[i + 1])
                if td == "false" or td == "0"
                    tunnel_dns = 0
                else
                    tunnel_dns = 1
                end
                i += 2
            else
                i += 1
            end
        end

        print_banner()
        let tp_init = tpool::thread_pool_init(crypto_threads, io_threads)
        if tp_init != 0
            say("[ERROR] Failed to initialize thread pool")
            return 1
        end
        say("[INFO] Thread pool initialized: " + crypto_threads + " crypto workers, " + io_threads + " I/O workers")

        let client_cfg = {
            "bind_address": bind_address,
            "local_port": proxy_port,
            "server_host": srv_host,
            "server_port": srv_port,
            "passphrase": pass,
            "forward_protocol": proto::parse_forward_protocol(forward_protocol_str) as int,
            "split_mode": split_mode,
            "apps": app_list,
            "domains": domain_list,
            "auto_sys_proxy": auto_sys_proxy,
            "kill_switch": kill_switch,
            "tunnel_dns": tunnel_dns,
            "dns_servers": dns_servers,
            "dns_resolvers": dns_resolvers,
            "bypass_lan": bypass_lan,
            "bypass_lan_ranges": bypass_lan_ranges,
            "auto_reconnect": auto_reconnect,
            "reconnect_attempts": reconnect_attempts,
            "reconnect_interval_ms": reconnect_interval_ms,
            "handshake_timeout_ms": handshake_timeout_ms,
            "connect_timeout_ms": connect_timeout_ms,
            "idle_timeout_sec": idle_timeout_sec,
            "ping_interval_sec": ping_interval_sec,
            "show_stats": show_stats,
            "stats_interval_sec": stats_interval_sec,
            "tcp_nodelay": tcp_nodelay,
            "log_tunnel_traffic": log_tunnel_traffic,
            "log_direct_traffic": log_direct_traffic
        }
        client::vpn_run_client_proxy(client_cfg)
        return 0
    end

    # --- COMMAND: CHECK PORT ---
    if cmd == "check-port"
        if len(args_list) < 2
            say("Usage: alya run src/main.alya -- check-port <port_number>")
            return 1
        end
        let target_port = proto::parse_number(args_list[1])
        say("Inspecting owner process for port " + target_port + "...")
        let proc_tcp = resolver::resolve_tcp_process(target_port)
        let proc_udp = resolver::resolve_udp_process(target_port)

        if len(proc_tcp) > 0
            say("  [TCP] Port " + target_port + " is owned by: " + proc_tcp)
        else
            say("  [TCP] No active TCP socket found on port " + target_port)
        end

        if len(proc_udp) > 0
            say("  [UDP] Port " + target_port + " is owned by: " + proc_udp)
        else
            say("  [UDP] No active UDP socket found on port " + target_port)
        end
        return 0
    end

    # --- COMMAND: BENCHMARK ---
    if cmd == "benchmark"
        print_banner()
        say("[BENCH] Initializing 256-bit ChaCha20-Poly1305 throughput test...")
        let key = crypto::vpn_derive_key("bench_secret_key_123456789")
        let chunk = "The quick brown fox jumps over the lazy dog! 1234567890\r\n"
        let p8 = chunk + chunk + chunk + chunk + chunk + chunk + chunk + chunk
        let payload = p8 + p8 + p8 + p8 # ~1.8 KB payload

        let iters = 1000
        say("[BENCH] Running " + iters + " full AEAD envelope pack/unpack cycles (" + len(payload) + " bytes each)...")

        let i = 0
        while i < iters
            let frame = proto::pack_frame(key, proto::msg_data(), payload)
            if frame == null
                say("[BENCH] Packing error at iteration " + i)
                return 1
            end
            let msg_type, plain = proto::unpack_frame(key, frame)
            if msg_type != proto::msg_data() or plain == null
                say("[BENCH] Unpacking error at iteration " + i)
                return 1
            end
            i += 1
        end

        say("[BENCH] 1000 AEAD roundtrips completed successfully with 100% integrity!")
        return 0
    end

    print_usage()
    return 0
end

main()
